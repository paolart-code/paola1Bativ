              "\n",
              "\n",
              "<!DOCTYPE html>\n",
              "\n",
              "<html lang=\"pt-BR\">\n",
              "\n",
              "<head>\n",
              "\n",
              "<meta charset=\"UTF-8\">\n",
              "\n",
              "<meta name=\"viewport\"\n",
              "content=\"width=device-width, initial-scale=1.0\">\n",
              "\n",
              "<title>Corrida do Luis</title>\n",
              "\n",
              "<style>\n",
              "\n",
              "body {\n",
              "\n",
              "    margin: 0;\n",
              "    padding: 0;\n",
              "\n",
              "    background: #202020;\n",
              "\n",
              "    font-family: Arial, sans-serif;\n",
              "\n",
              "    text-align: center;\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "#container {\n",
              "\n",
              "    width: 1000px;\n",
              "\n",
              "    max-width: 95vw;\n",
              "\n",
              "    margin: 15px auto;\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "canvas {\n",
              "\n",
              "    width: 100%;\n",
              "\n",
              "    height: auto;\n",
              "\n",
              "    display: block;\n",
              "\n",
              "    border: 3px solid white;\n",
              "\n",
              "    border-radius: 8px;\n",
              "\n",
              "    image-rendering: pixelated;\n",
              "\n",
              "    box-sizing: border-box;\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "#controles {\n",
              "\n",
              "    margin-top: 12px;\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "button {\n",
              "\n",
              "    font-size: 18px;\n",
              "\n",
              "    padding: 12px 20px;\n",
              "\n",
              "    margin: 5px;\n",
              "\n",
              "    border: none;\n",
              "\n",
              "    border-radius: 10px;\n",
              "\n",
              "    cursor: pointer;\n",
              "\n",
              "    touch-action: none;\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "button:active {\n",
              "\n",
              "    transform: scale(0.95);\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "#mensagem {\n",
              "\n",
              "    color: white;\n",
              "\n",
              "    font-size: 18px;\n",
              "\n",
              "    margin-top: 8px;\n",
              "\n",
              "}\n",
              "\n",
              "</style>\n",
              "\n",
              "</head>\n",
              "\n",
              "\n",
              "<body>\n",
              "\n",
              "\n",
              "<div id=\"container\">\n",
              "\n",
              "\n",
              "<canvas\n",
              "    id=\"canvas\"\n",
              "    width=\"1000\"\n",
              "    height=\"666\">\n",
              "</canvas>\n",
              "\n",
              "\n",
              "<div id=\"controles\">\n",
              "\n",
              "<button id=\"pular\">\n",
              "⬆️ PULAR\n",
              "</button>\n",
              "\n",
              "<button id=\"agachar\">\n",
              "⬇️ AGACHAR\n",
              "</button>\n",
              "\n",
              "<button id=\"reiniciar\">\n",
              "🔄 REINICIAR\n",
              "</button>\n",
              "\n",
              "</div>\n",
              "\n",
              "\n",
              "<div id=\"mensagem\">\n",
              "🏃 Luis está correndo!\n",
              "</div>\n",
              "\n",
              "\n",
              "</div>\n",
              "\n",
              "\n",
              "<script>\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// IMAGENS\n",
              "// ============================================================\n",
              "\n",
              "const imagens = {\"fundo\": \"data:image/png;base64,\", \"giz_chao\": \"data:image/png;base64,\", \"giz_voador\": \"data:image/png;base64,\", \"correndo1\": \"data:image/png;base64,\", \"correndo2\": \"data:image/png;base64,\", \"correndo3\": \"data:image/png;base64,\", \"correndo4\": \"data:image/png;base64,\", \"pulo1\": \"data:image/png;base64,\", \"pulo2\": \"data:image/png;base64,\", \"pulo3\": \"data:image/png;base64,\", \"agachado2\": \"data:image/png;base64,\", \"parado\": \"data:image/png;base64,\"};\n",
              "\n",
              "\n",
              "function criarImagem(src) {\n",
              "\n",
              "    const img = new Image();\n",
              "\n",
              "    img.src = src || \"\";\n",
              "\n",
              "    return img;\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// CENÁRIO\n",
              "// ============================================================\n",
              "\n",
              "const imagemFundo =\n",
              "    criarImagem(\n",
              "        imagens.fundo\n",
              "    );\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// GIZES\n",
              "// ============================================================\n",
              "\n",
              "const imagemGizChao =\n",
              "    criarImagem(\n",
              "        imagens.giz_chao\n",
              "    );\n",
              "\n",
              "\n",
              "const imagemGizVoador =\n",
              "    criarImagem(\n",
              "        imagens.giz_voador\n",
              "    );\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// CORRIDA\n",
              "// ============================================================\n",
              "\n",
              "const corrida = [\n",
              "\n",
              "    criarImagem(imagens.correndo1),\n",
              "    criarImagem(imagens.correndo2),\n",
              "    criarImagem(imagens.correndo3),\n",
              "    criarImagem(imagens.correndo4)\n",
              "\n",
              "];\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// PULO\n",
              "// ============================================================\n",
              "\n",
              "const pulos = [\n",
              "\n",
              "    criarImagem(imagens.pulo1),\n",
              "    criarImagem(imagens.pulo2),\n",
              "    criarImagem(imagens.pulo3)\n",
              "\n",
              "];\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// AGACHAMENTO\n",
              "// ============================================================\n",
              "\n",
              "const agachamentos = [\n",
              "\n",
              "    criarImagem(\n",
              "        imagens.agachado2\n",
              "    )\n",
              "\n",
              "];\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// PARADO\n",
              "// ============================================================\n",
              "\n",
              "const spriteParado =\n",
              "    criarImagem(\n",
              "        imagens.parado\n",
              "    );\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// CANVAS\n",
              "// ============================================================\n",
              "\n",
              "const canvas =\n",
              "    document.getElementById(\n",
              "        \"canvas\"\n",
              "    );\n",
              "\n",
              "\n",
              "const ctx =\n",
              "    canvas.getContext(\n",
              "        \"2d\"\n",
              "    );\n",
              "\n",
              "\n",
              "ctx.imageSmoothingEnabled =\n",
              "    false;\n",
              "\n",
              "\n",
              "const LARGURA =\n",
              "    canvas.width;\n",
              "\n",
              "\n",
              "const ALTURA =\n",
              "    canvas.height;\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// CHÃO\n",
              "// ============================================================\n",
              "\n",
              "const CHAO = 461;\n",
              "\n",
              "const CHAO_AGACHADO = 490;\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// TAMANHO NORMAL\n",
              "// ============================================================\n",
              "\n",
              "const LUIS_LARGURA = 105;\n",
              "\n",
              "const LUIS_ALTURA = 105;\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// TAMANHO AGACHADO\n",
              "// ============================================================\n",
              "\n",
              "const LUIS_AGACHADO_LARGURA = 130;\n",
              "\n",
              "const LUIS_AGACHADO_ALTURA = 136;\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// FÍSICA\n",
              "// ============================================================\n",
              "\n",
              "const GRAVIDADE = 0.75;\n",
              "\n",
              "const FORCA_PULO = -17;\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// CENÁRIO\n",
              "// ============================================================\n",
              "\n",
              "let deslocamentoCenario = 0;\n",
              "\n",
              "let larguraCenario = 0;\n",
              "\n",
              "let panoramaPronto = false;\n",
              "\n",
              "const POSICAO_VERTICAL_CENARIO = 0;\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// PERSONAGEM\n",
              "// ============================================================\n",
              "\n",
              "let luis = {\n",
              "\n",
              "    x: 130,\n",
              "\n",
              "    y:\n",
              "        CHAO -\n",
              "        LUIS_ALTURA,\n",
              "\n",
              "    largura:\n",
              "        LUIS_LARGURA,\n",
              "\n",
              "    altura:\n",
              "        LUIS_ALTURA,\n",
              "\n",
              "    velocidadeY: 0,\n",
              "\n",
              "    pulando: false,\n",
              "\n",
              "    agachado: false,\n",
              "\n",
              "    frameCorrida: 0,\n",
              "\n",
              "    framePulo: 0,\n",
              "\n",
              "    frameAgachado: 0,\n",
              "\n",
              "    contadorAnimacao: 0,\n",
              "\n",
              "    alturaPulo: 0\n",
              "\n",
              "};\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// ESTADO\n",
              "// ============================================================\n",
              "\n",
              "let jogoRodando = true;\n",
              "\n",
              "let jogoPerdido = false;\n",
              "\n",
              "let pontuacao = 0;\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// PONTUAÇÃO\n",
              "// ============================================================\n",
              "//\n",
              "// A pontuação sobe continuamente enquanto o personagem\n",
              "// corre.\n",
              "//\n",
              "// O sistema usa o tempo do jogo, parecido com o conceito\n",
              "// de pontuação contínua do Dino Runner.\n",
              "//\n",
              "// ============================================================\n",
              "\n",
              "let acumuladorPontuacao = 0;\n",
              "\n",
              "\n",
              "// Quantos pontos por segundo aproximadamente.\n",
              "//\n",
              "// 100 pontos = 10 segundos no ritmo inicial.\n",
              "//\n",
              "// Conforme o jogo fica mais rápido, a pontuação acompanha\n",
              "// a velocidade.\n",
              "//\n",
              "// ============================================================\n",
              "\n",
              "const PONTOS_POR_SEGUNDO = 10;\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// VELOCIDADE\n",
              "// ============================================================\n",
              "//\n",
              "// A velocidade inicial foi aumentada.\n",
              "//\n",
              "// A cada 100 pontos ocorre um aumento.\n",
              "//\n",
              "// ============================================================\n",
              "\n",
              "const VELOCIDADE_INICIAL = 7.0;\n",
              "\n",
              "\n",
              "// Aumento de velocidade a cada 100 pontos.\n",
              "\n",
              "const AUMENTO_A_CADA_100 = 0.75;\n",
              "\n",
              "\n",
              "// Limite máximo.\n",
              "\n",
              "const VELOCIDADE_MAXIMA = 20;\n",
              "\n",
              "\n",
              "let velocidade =\n",
              "    VELOCIDADE_INICIAL;\n",
              "\n",
              "\n",
              "let nivelVelocidade = 0;\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// VELOCIDADE DO GIZ VOADOR\n",
              "// ============================================================\n",
              "\n",
              "const MULTIPLICADOR_GIZ_VOADOR = 1.8;\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// DISTÂNCIA DOS GIZES DO CHÃO\n",
              "// ============================================================\n",
              "//\n",
              "// Distância maior para facilitar o pulo.\n",
              "//\n",
              "// O intervalo entre eles também é aleatório.\n",
              "//\n",
              "// ============================================================\n",
              "\n",
              "const DISTANCIA_MINIMA_GIZ_CHAO = 380;\n",
              "\n",
              "const DISTANCIA_MAXIMA_GIZ_CHAO = 650;\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// DISTÂNCIA MÍNIMA ENTRE OBSTÁCULOS\n",
              "// ============================================================\n",
              "\n",
              "const DISTANCIA_MINIMA_OBSTACULOS = 300;\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// CONTROLE\n",
              "// ============================================================\n",
              "\n",
              "let pressionandoBaixo = false;\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// PREPARAR CENÁRIO\n",
              "// ============================================================\n",
              "\n",
              "function prepararPanorama() {\n",
              "\n",
              "    if (\n",
              "\n",
              "        !imagemFundo.complete ||\n",
              "\n",
              "        imagemFundo.naturalWidth <= 0 ||\n",
              "\n",
              "        imagemFundo.naturalHeight <= 0\n",
              "\n",
              "    ) {\n",
              "\n",
              "        return;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    if (panoramaPronto) {\n",
              "\n",
              "        return;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    const escala =\n",
              "\n",
              "        ALTURA /\n",
              "        imagemFundo.naturalHeight;\n",
              "\n",
              "\n",
              "    larguraCenario =\n",
              "\n",
              "        imagemFundo.naturalWidth *\n",
              "        escala;\n",
              "\n",
              "\n",
              "    panoramaPronto = true;\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// PULAR\n",
              "// ============================================================\n",
              "\n",
              "function pular() {\n",
              "\n",
              "    if (\n",
              "\n",
              "        !jogoRodando ||\n",
              "\n",
              "        luis.pulando ||\n",
              "\n",
              "        luis.agachado\n",
              "\n",
              "    ) {\n",
              "\n",
              "        return;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    luis.pulando = true;\n",
              "\n",
              "    luis.velocidadeY =\n",
              "        FORCA_PULO;\n",
              "\n",
              "    luis.framePulo = 0;\n",
              "\n",
              "    luis.contadorAnimacao = 0;\n",
              "\n",
              "    luis.alturaPulo = 0;\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// AGACHAR\n",
              "// ============================================================\n",
              "\n",
              "function agachar(estado) {\n",
              "\n",
              "    pressionandoBaixo =\n",
              "        estado;\n",
              "\n",
              "\n",
              "    if (!jogoRodando) {\n",
              "\n",
              "        return;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    if (!luis.pulando) {\n",
              "\n",
              "        luis.agachado =\n",
              "            estado;\n",
              "\n",
              "\n",
              "        if (estado) {\n",
              "\n",
              "            luis.largura =\n",
              "                LUIS_AGACHADO_LARGURA;\n",
              "\n",
              "            luis.altura =\n",
              "                LUIS_AGACHADO_ALTURA;\n",
              "\n",
              "            luis.y =\n",
              "                CHAO_AGACHADO -\n",
              "                luis.altura;\n",
              "\n",
              "        }\n",
              "\n",
              "        else {\n",
              "\n",
              "            luis.largura =\n",
              "                LUIS_LARGURA;\n",
              "\n",
              "            luis.altura =\n",
              "                LUIS_ALTURA;\n",
              "\n",
              "            luis.y =\n",
              "                CHAO -\n",
              "                luis.altura;\n",
              "\n",
              "        }\n",
              "\n",
              "    }\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// ANIMAÇÃO\n",
              "// ============================================================\n",
              "\n",
              "function atualizarAnimacao() {\n",
              "\n",
              "    luis.contadorAnimacao++;\n",
              "\n",
              "\n",
              "    if (luis.pulando) {\n",
              "\n",
              "        if (\n",
              "            luis.contadorAnimacao >= 7\n",
              "        ) {\n",
              "\n",
              "            luis.framePulo++;\n",
              "\n",
              "\n",
              "            if (\n",
              "                luis.framePulo >=\n",
              "                pulos.length\n",
              "            ) {\n",
              "\n",
              "                luis.framePulo =\n",
              "                    pulos.length - 1;\n",
              "\n",
              "            }\n",
              "\n",
              "\n",
              "            luis.contadorAnimacao = 0;\n",
              "\n",
              "        }\n",
              "\n",
              "\n",
              "        return;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    if (luis.agachado) {\n",
              "\n",
              "        luis.frameAgachado = 0;\n",
              "\n",
              "        return;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    if (\n",
              "        luis.contadorAnimacao >= 6\n",
              "    ) {\n",
              "\n",
              "        luis.frameCorrida++;\n",
              "\n",
              "        luis.frameCorrida %=\n",
              "\n",
              "            corrida.length;\n",
              "\n",
              "        luis.contadorAnimacao = 0;\n",
              "\n",
              "    }\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// ATUALIZAR LUIS\n",
              "// ============================================================\n",
              "\n",
              "function atualizarLuis() {\n",
              "\n",
              "    atualizarAnimacao();\n",
              "\n",
              "\n",
              "    // --------------------------------------------------------\n",
              "    // PULO\n",
              "    // --------------------------------------------------------\n",
              "\n",
              "    if (luis.pulando) {\n",
              "\n",
              "        luis.velocidadeY +=\n",
              "            GRAVIDADE;\n",
              "\n",
              "\n",
              "        luis.alturaPulo -=\n",
              "            luis.velocidadeY;\n",
              "\n",
              "\n",
              "        if (\n",
              "\n",
              "            luis.alturaPulo <= 0 &&\n",
              "\n",
              "            luis.velocidadeY > 0\n",
              "\n",
              "        ) {\n",
              "\n",
              "            luis.alturaPulo = 0;\n",
              "\n",
              "            luis.velocidadeY = 0;\n",
              "\n",
              "            luis.pulando = false;\n",
              "\n",
              "            luis.framePulo = 0;\n",
              "\n",
              "            luis.contadorAnimacao = 0;\n",
              "\n",
              "\n",
              "            luis.largura =\n",
              "                LUIS_LARGURA;\n",
              "\n",
              "            luis.altura =\n",
              "                LUIS_ALTURA;\n",
              "\n",
              "\n",
              "            if (pressionandoBaixo) {\n",
              "\n",
              "                luis.agachado = true;\n",
              "\n",
              "                luis.largura =\n",
              "                    LUIS_AGACHADO_LARGURA;\n",
              "\n",
              "                luis.altura =\n",
              "                    LUIS_AGACHADO_ALTURA;\n",
              "\n",
              "                luis.y =\n",
              "                    CHAO_AGACHADO -\n",
              "                    luis.altura;\n",
              "\n",
              "            }\n",
              "\n",
              "        }\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    // --------------------------------------------------------\n",
              "    // POSIÇÃO VERTICAL\n",
              "    // --------------------------------------------------------\n",
              "\n",
              "    if (!luis.pulando) {\n",
              "\n",
              "        if (luis.agachado) {\n",
              "\n",
              "            luis.y =\n",
              "                CHAO_AGACHADO -\n",
              "                luis.altura;\n",
              "\n",
              "        }\n",
              "\n",
              "        else {\n",
              "\n",
              "            luis.y =\n",
              "                CHAO -\n",
              "                luis.altura;\n",
              "\n",
              "        }\n",
              "\n",
              "    }\n",
              "\n",
              "    else {\n",
              "\n",
              "        luis.y =\n",
              "\n",
              "            CHAO -\n",
              "\n",
              "            luis.altura -\n",
              "\n",
              "            luis.alturaPulo;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    // --------------------------------------------------------\n",
              "    // AGACHAMENTO\n",
              "    // --------------------------------------------------------\n",
              "\n",
              "    if (!luis.pulando) {\n",
              "\n",
              "        if (pressionandoBaixo) {\n",
              "\n",
              "            luis.agachado = true;\n",
              "\n",
              "            luis.largura =\n",
              "                LUIS_AGACHADO_LARGURA;\n",
              "\n",
              "            luis.altura =\n",
              "                LUIS_AGACHADO_ALTURA;\n",
              "\n",
              "            luis.y =\n",
              "                CHAO_AGACHADO -\n",
              "                luis.altura;\n",
              "\n",
              "        }\n",
              "\n",
              "        else {\n",
              "\n",
              "            luis.agachado = false;\n",
              "\n",
              "            luis.largura =\n",
              "                LUIS_LARGURA;\n",
              "\n",
              "            luis.altura =\n",
              "                LUIS_ALTURA;\n",
              "\n",
              "            luis.y =\n",
              "                CHAO -\n",
              "                luis.altura;\n",
              "\n",
              "        }\n",
              "\n",
              "    }\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// OBSTÁCULOS\n",
              "// ============================================================\n",
              "\n",
              "let obstaculos = [];\n",
              "\n",
              "let contadorObstaculo = 0;\n",
              "\n",
              "let intervaloObstaculo = 100;\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// ÚLTIMA POSIÇÃO DO GIZ DO CHÃO\n",
              "// ============================================================\n",
              "\n",
              "let ultimoSpawnChaoX = -9999;\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// GIZ DO CHÃO\n",
              "// ============================================================\n",
              "\n",
              "function criarObstaculoChao(\n",
              "    xExtra = 0\n",
              ") {\n",
              "\n",
              "    const largura = 85;\n",
              "\n",
              "    const altura = 70;\n",
              "\n",
              "\n",
              "    // ========================================================\n",
              "    // DISTÂNCIA ALEATÓRIA\n",
              "    // ========================================================\n",
              "\n",
              "    const distanciaAleatoria =\n",
              "\n",
              "        DISTANCIA_MINIMA_GIZ_CHAO +\n",
              "\n",
              "        Math.random() *\n",
              "\n",
              "        (\n",
              "            DISTANCIA_MAXIMA_GIZ_CHAO -\n",
              "            DISTANCIA_MINIMA_GIZ_CHAO\n",
              "        );\n",
              "\n",
              "\n",
              "    let posicaoX =\n",
              "\n",
              "        LARGURA +\n",
              "        80 +\n",
              "        xExtra;\n",
              "\n",
              "\n",
              "    // ========================================================\n",
              "    // GARANTIR DISTÂNCIA\n",
              "    // ========================================================\n",
              "\n",
              "    if (\n",
              "\n",
              "        ultimoSpawnChaoX > -9000 &&\n",
              "\n",
              "        posicaoX <\n",
              "            ultimoSpawnChaoX +\n",
              "            distanciaAleatoria\n",
              "\n",
              "    ) {\n",
              "\n",
              "        posicaoX =\n",
              "\n",
              "            ultimoSpawnChaoX +\n",
              "            distanciaAleatoria;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    obstaculos.push({\n",
              "\n",
              "        tipo: \"chao\",\n",
              "\n",
              "        x:\n",
              "            posicaoX,\n",
              "\n",
              "        y:\n",
              "            CHAO -\n",
              "            altura,\n",
              "\n",
              "        largura:\n",
              "            largura,\n",
              "\n",
              "        altura:\n",
              "            altura,\n",
              "\n",
              "        velocidade:\n",
              "            velocidade\n",
              "\n",
              "    });\n",
              "\n",
              "\n",
              "    ultimoSpawnChaoX =\n",
              "        posicaoX;\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// GIZ VOADOR\n",
              "// ============================================================\n",
              "\n",
              "function criarObstaculoVoador(\n",
              "    xExtra = 0\n",
              ") {\n",
              "\n",
              "    const largura = 70;\n",
              "\n",
              "    const altura = 48;\n",
              "\n",
              "\n",
              "    // ========================================================\n",
              "    // ALTURA DO GIZ VOADOR\n",
              "    // ========================================================\n",
              "\n",
              "    const yBase =\n",
              "        CHAO - 115;\n",
              "\n",
              "\n",
              "    const posicaoX =\n",
              "\n",
              "        LARGURA +\n",
              "        80 +\n",
              "        xExtra;\n",
              "\n",
              "\n",
              "    obstaculos.push({\n",
              "\n",
              "        tipo: \"voador\",\n",
              "\n",
              "        x:\n",
              "            posicaoX,\n",
              "\n",
              "        y:\n",
              "            yBase,\n",
              "\n",
              "        yBase:\n",
              "            yBase,\n",
              "\n",
              "        largura:\n",
              "            largura,\n",
              "\n",
              "        altura:\n",
              "            altura,\n",
              "\n",
              "        velocidade:\n",
              "\n",
              "            velocidade *\n",
              "            MULTIPLICADOR_GIZ_VOADOR,\n",
              "\n",
              "        angulo:\n",
              "\n",
              "            Math.random() *\n",
              "            Math.PI *\n",
              "            2,\n",
              "\n",
              "        velocidadeRotacao:\n",
              "\n",
              "            0.08 +\n",
              "            Math.random() * 0.04\n",
              "\n",
              "    });\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// CRIAR GRUPO DE OBSTÁCULOS\n",
              "// ============================================================\n",
              "\n",
              "function criarGrupoObstaculos() {\n",
              "\n",
              "    const sorteio =\n",
              "        Math.random();\n",
              "\n",
              "\n",
              "    // ========================================================\n",
              "    // INÍCIO DO JOGO\n",
              "    // ========================================================\n",
              "\n",
              "    if (pontuacao < 100) {\n",
              "\n",
              "        if (sorteio < 0.58) {\n",
              "\n",
              "            criarObstaculoChao();\n",
              "\n",
              "        }\n",
              "\n",
              "        else if (sorteio < 0.84) {\n",
              "\n",
              "            criarObstaculoVoador();\n",
              "\n",
              "        }\n",
              "\n",
              "        else {\n",
              "\n",
              "            criarObstaculoChao();\n",
              "\n",
              "\n",
              "            const distancia =\n",
              "\n",
              "                DISTANCIA_MINIMA_GIZ_CHAO +\n",
              "\n",
              "                Math.random() *\n",
              "                180;\n",
              "\n",
              "\n",
              "            criarObstaculoChao(\n",
              "                distancia\n",
              "            );\n",
              "\n",
              "        }\n",
              "\n",
              "        return;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    // ========================================================\n",
              "    // JOGO MAIS RÁPIDO\n",
              "    // ========================================================\n",
              "\n",
              "    if (pontuacao < 300) {\n",
              "\n",
              "        if (sorteio < 0.45) {\n",
              "\n",
              "            criarObstaculoChao();\n",
              "\n",
              "        }\n",
              "\n",
              "        else if (sorteio < 0.70) {\n",
              "\n",
              "            criarObstaculoVoador();\n",
              "\n",
              "        }\n",
              "\n",
              "        else if (sorteio < 0.88) {\n",
              "\n",
              "            criarObstaculoChao();\n",
              "\n",
              "\n",
              "            const distancia =\n",
              "\n",
              "                DISTANCIA_MINIMA_GIZ_CHAO +\n",
              "\n",
              "                Math.random() *\n",
              "                200;\n",
              "\n",
              "\n",
              "            criarObstaculoChao(\n",
              "                distancia\n",
              "            );\n",
              "\n",
              "        }\n",
              "\n",
              "        else {\n",
              "\n",
              "            criarObstaculoChao();\n",
              "\n",
              "\n",
              "            const distancia =\n",
              "\n",
              "                DISTANCIA_MINIMA_OBSTACULOS +\n",
              "\n",
              "                Math.random() *\n",
              "                180;\n",
              "\n",
              "\n",
              "            criarObstaculoVoador(\n",
              "                distancia\n",
              "            );\n",
              "\n",
              "        }\n",
              "\n",
              "        return;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    // ========================================================\n",
              "    // JOGO AVANÇADO\n",
              "    // ========================================================\n",
              "\n",
              "    if (sorteio < 0.38) {\n",
              "\n",
              "        criarObstaculoChao();\n",
              "\n",
              "    }\n",
              "\n",
              "    else if (sorteio < 0.64) {\n",
              "\n",
              "        criarObstaculoVoador();\n",
              "\n",
              "    }\n",
              "\n",
              "    else if (sorteio < 0.82) {\n",
              "\n",
              "        criarObstaculoChao();\n",
              "\n",
              "\n",
              "        const distancia =\n",
              "\n",
              "            DISTANCIA_MINIMA_GIZ_CHAO +\n",
              "\n",
              "            Math.random() *\n",
              "            220;\n",
              "\n",
              "\n",
              "        criarObstaculoChao(\n",
              "            distancia\n",
              "        );\n",
              "\n",
              "    }\n",
              "\n",
              "    else {\n",
              "\n",
              "        criarObstaculoChao();\n",
              "\n",
              "\n",
              "        const distancia =\n",
              "\n",
              "            DISTANCIA_MINIMA_OBSTACULOS +\n",
              "\n",
              "            Math.random() *\n",
              "            220;\n",
              "\n",
              "\n",
              "        criarObstaculoVoador(\n",
              "            distancia\n",
              "        );\n",
              "\n",
              "    }\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// ATUALIZAR OBSTÁCULOS\n",
              "// ============================================================\n",
              "\n",
              "function atualizarObstaculos() {\n",
              "\n",
              "    contadorObstaculo++;\n",
              "\n",
              "\n",
              "    // ========================================================\n",
              "    // DIFICULDADE DO SPAWN\n",
              "    // ========================================================\n",
              "\n",
              "    const nivelDificuldade =\n",
              "\n",
              "        Math.floor(\n",
              "            pontuacao / 100\n",
              "        );\n",
              "\n",
              "\n",
              "    let reducao =\n",
              "\n",
              "        Math.min(\n",
              "            nivelDificuldade * 3,\n",
              "            15\n",
              "        );\n",
              "\n",
              "\n",
              "    let intervaloMinimo =\n",
              "\n",
              "        90 -\n",
              "        reducao;\n",
              "\n",
              "\n",
              "    let intervaloMaximo =\n",
              "\n",
              "        135 -\n",
              "        reducao;\n",
              "\n",
              "\n",
              "    if (\n",
              "        intervaloMinimo < 70\n",
              "    ) {\n",
              "\n",
              "        intervaloMinimo = 70;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    if (\n",
              "        intervaloMaximo < 90\n",
              "    ) {\n",
              "\n",
              "        intervaloMaximo = 90;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    // ========================================================\n",
              "    // SPAWN\n",
              "    // ========================================================\n",
              "\n",
              "    if (\n",
              "        contadorObstaculo >=\n",
              "        intervaloObstaculo\n",
              "    ) {\n",
              "\n",
              "        criarGrupoObstaculos();\n",
              "\n",
              "        contadorObstaculo = 0;\n",
              "\n",
              "\n",
              "        intervaloObstaculo =\n",
              "\n",
              "            intervaloMinimo +\n",
              "\n",
              "            Math.random() *\n",
              "\n",
              "            (\n",
              "                intervaloMaximo -\n",
              "                intervaloMinimo\n",
              "            );\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    // ========================================================\n",
              "    // MOVER GIZES\n",
              "    // ========================================================\n",
              "\n",
              "    for (\n",
              "\n",
              "        let i =\n",
              "            obstaculos.length - 1;\n",
              "\n",
              "        i >= 0;\n",
              "\n",
              "        i--\n",
              "\n",
              "    ) {\n",
              "\n",
              "        const obstaculo =\n",
              "            obstaculos[i];\n",
              "\n",
              "\n",
              "        // ====================================================\n",
              "        // GIZ VOADOR\n",
              "        // ====================================================\n",
              "\n",
              "        if (\n",
              "            obstaculo.tipo ===\n",
              "            \"voador\"\n",
              "        ) {\n",
              "\n",
              "            obstaculo.velocidade =\n",
              "\n",
              "                velocidade *\n",
              "                MULTIPLICADOR_GIZ_VOADOR;\n",
              "\n",
              "\n",
              "            obstaculo.x -=\n",
              "                obstaculo.velocidade;\n",
              "\n",
              "\n",
              "            obstaculo.y =\n",
              "                obstaculo.yBase;\n",
              "\n",
              "\n",
              "            obstaculo.angulo +=\n",
              "                obstaculo.velocidadeRotacao;\n",
              "\n",
              "        }\n",
              "\n",
              "        else {\n",
              "\n",
              "            // =================================================\n",
              "            // GIZ DO CHÃO\n",
              "            // =================================================\n",
              "\n",
              "            obstaculo.velocidade =\n",
              "                velocidade;\n",
              "\n",
              "\n",
              "            obstaculo.x -=\n",
              "                obstaculo.velocidade;\n",
              "\n",
              "        }\n",
              "\n",
              "\n",
              "        // ====================================================\n",
              "        // REMOVER GIZ QUE SAIU DA TELA\n",
              "        // ====================================================\n",
              "\n",
              "        if (\n",
              "\n",
              "            obstaculo.x +\n",
              "            obstaculo.largura < 0\n",
              "\n",
              "        ) {\n",
              "\n",
              "            obstaculos.splice(\n",
              "                i,\n",
              "                1\n",
              "            );\n",
              "\n",
              "        }\n",
              "\n",
              "    }\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// ATUALIZAR PONTUAÇÃO\n",
              "// ============================================================\n",
              "//\n",
              "// A pontuação agora é baseada no tempo.\n",
              "//\n",
              "// Ela não depende dos gizes.\n",
              "//\n",
              "// Portanto o jogador ganha pontos simplesmente por continuar\n",
              "// correndo.\n",
              "//\n",
              "// ============================================================\n",
              "\n",
              "function atualizarPontuacao() {\n",
              "\n",
              "    // Aproximação de 60 FPS.\n",
              "    //\n",
              "    // Isso deixa a pontuação estável mesmo se o computador\n",
              "    // tiver pequenas variações no FPS.\n",
              "\n",
              "    acumuladorPontuacao +=\n",
              "        PONTOS_POR_SEGUNDO / 60;\n",
              "\n",
              "\n",
              "    if (\n",
              "        acumuladorPontuacao >= 1\n",
              "    ) {\n",
              "\n",
              "        const pontosInteiros =\n",
              "\n",
              "            Math.floor(\n",
              "                acumuladorPontuacao\n",
              "            );\n",
              "\n",
              "\n",
              "        pontuacao +=\n",
              "            pontosInteiros;\n",
              "\n",
              "\n",
              "        acumuladorPontuacao -=\n",
              "            pontosInteiros;\n",
              "\n",
              "    }\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// ATUALIZAR VELOCIDADE\n",
              "// ============================================================\n",
              "//\n",
              "// A cada 100 pontos aumenta a velocidade.\n",
              "//\n",
              "// Exemplo:\n",
              "//\n",
              "// 0 pontos    = 7.00\n",
              "// 100 pontos  = 7.75\n",
              "// 200 pontos  = 8.50\n",
              "// 300 pontos  = 9.25\n",
              "// 400 pontos  = 10.00\n",
              "//\n",
              "// E continua aumentando até a velocidade máxima.\n",
              "//\n",
              "// ============================================================\n",
              "\n",
              "function atualizarVelocidade() {\n",
              "\n",
              "    const novoNivel =\n",
              "\n",
              "        Math.floor(\n",
              "            pontuacao / 100\n",
              "        );\n",
              "\n",
              "\n",
              "    if (\n",
              "        novoNivel !==\n",
              "        nivelVelocidade\n",
              "    ) {\n",
              "\n",
              "        nivelVelocidade =\n",
              "            novoNivel;\n",
              "\n",
              "\n",
              "        velocidade =\n",
              "\n",
              "            VELOCIDADE_INICIAL +\n",
              "\n",
              "            (\n",
              "                nivelVelocidade *\n",
              "                AUMENTO_A_CADA_100\n",
              "            );\n",
              "\n",
              "\n",
              "        if (\n",
              "            velocidade >\n",
              "            VELOCIDADE_MAXIMA\n",
              "        ) {\n",
              "\n",
              "            velocidade =\n",
              "                VELOCIDADE_MAXIMA;\n",
              "\n",
              "        }\n",
              "\n",
              "    }\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// ATUALIZAR CENÁRIO\n",
              "// ============================================================\n",
              "\n",
              "function atualizarCenario() {\n",
              "\n",
              "    prepararPanorama();\n",
              "\n",
              "\n",
              "    if (\n",
              "\n",
              "        !panoramaPronto ||\n",
              "\n",
              "        larguraCenario <= 0\n",
              "\n",
              "    ) {\n",
              "\n",
              "        return;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    deslocamentoCenario +=\n",
              "        velocidade;\n",
              "\n",
              "\n",
              "    while (\n",
              "\n",
              "        deslocamentoCenario >=\n",
              "        larguraCenario\n",
              "\n",
              "    ) {\n",
              "\n",
              "        deslocamentoCenario -=\n",
              "            larguraCenario;\n",
              "\n",
              "    }\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// DESENHAR CENÁRIO\n",
              "// ============================================================\n",
              "\n",
              "function desenharCenario() {\n",
              "\n",
              "    ctx.fillStyle =\n",
              "        \"#168bd0\";\n",
              "\n",
              "\n",
              "    ctx.fillRect(\n",
              "\n",
              "        0,\n",
              "        0,\n",
              "        LARGURA,\n",
              "        ALTURA\n",
              "\n",
              "    );\n",
              "\n",
              "\n",
              "    prepararPanorama();\n",
              "\n",
              "\n",
              "    if (\n",
              "\n",
              "        !panoramaPronto ||\n",
              "\n",
              "        larguraCenario <= 0\n",
              "\n",
              "    ) {\n",
              "\n",
              "        return;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    const x =\n",
              "        -deslocamentoCenario;\n",
              "\n",
              "\n",
              "    ctx.drawImage(\n",
              "\n",
              "        imagemFundo,\n",
              "\n",
              "        x,\n",
              "\n",
              "        POSICAO_VERTICAL_CENARIO,\n",
              "\n",
              "        larguraCenario,\n",
              "\n",
              "        ALTURA\n",
              "\n",
              "    );\n",
              "\n",
              "\n",
              "    ctx.drawImage(\n",
              "\n",
              "        imagemFundo,\n",
              "\n",
              "        x +\n",
              "        larguraCenario,\n",
              "\n",
              "        POSICAO_VERTICAL_CENARIO,\n",
              "\n",
              "        larguraCenario,\n",
              "\n",
              "        ALTURA\n",
              "\n",
              "    );\n",
              "\n",
              "\n",
              "    ctx.drawImage(\n",
              "\n",
              "        imagemFundo,\n",
              "\n",
              "        x +\n",
              "        larguraCenario * 2,\n",
              "\n",
              "        POSICAO_VERTICAL_CENARIO,\n",
              "\n",
              "        larguraCenario,\n",
              "\n",
              "        ALTURA\n",
              "\n",
              "    );\n",
              "\n",
              "\n",
              "    ctx.drawImage(\n",
              "\n",
              "        imagemFundo,\n",
              "\n",
              "        x +\n",
              "        larguraCenario * 3,\n",
              "\n",
              "        POSICAO_VERTICAL_CENARIO,\n",
              "\n",
              "        larguraCenario,\n",
              "\n",
              "        ALTURA\n",
              "\n",
              "    );\n",
              "\n",
              "\n",
              "    ctx.drawImage(\n",
              "\n",
              "        imagemFundo,\n",
              "\n",
              "        x -\n",
              "        larguraCenario,\n",
              "\n",
              "        POSICAO_VERTICAL_CENARIO,\n",
              "\n",
              "        larguraCenario,\n",
              "\n",
              "        ALTURA\n",
              "\n",
              "    );\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// DESENHAR IMAGEM PROPORCIONAL\n",
              "// ============================================================\n",
              "\n",
              "function desenharImagemProporcional(\n",
              "\n",
              "    imagem,\n",
              "\n",
              "    x,\n",
              "\n",
              "    y,\n",
              "\n",
              "    larguraMaxima,\n",
              "\n",
              "    alturaMaxima,\n",
              "\n",
              "    alinharEmbaixo = false\n",
              "\n",
              ") {\n",
              "\n",
              "    if (\n",
              "\n",
              "        !imagem ||\n",
              "\n",
              "        !imagem.complete ||\n",
              "\n",
              "        imagem.naturalWidth <= 0 ||\n",
              "\n",
              "        imagem.naturalHeight <= 0\n",
              "\n",
              "    ) {\n",
              "\n",
              "        return;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    const proporcao =\n",
              "\n",
              "        imagem.naturalWidth /\n",
              "        imagem.naturalHeight;\n",
              "\n",
              "\n",
              "    let largura =\n",
              "        larguraMaxima;\n",
              "\n",
              "\n",
              "    let altura =\n",
              "        largura /\n",
              "        proporcao;\n",
              "\n",
              "\n",
              "    if (\n",
              "        altura >\n",
              "        alturaMaxima\n",
              "    ) {\n",
              "\n",
              "        altura =\n",
              "            alturaMaxima;\n",
              "\n",
              "\n",
              "        largura =\n",
              "            altura *\n",
              "            proporcao;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    if (\n",
              "        largura >\n",
              "        larguraMaxima\n",
              "    ) {\n",
              "\n",
              "        largura =\n",
              "            larguraMaxima;\n",
              "\n",
              "\n",
              "        altura =\n",
              "            largura /\n",
              "            proporcao;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    const posX =\n",
              "\n",
              "        x +\n",
              "        (\n",
              "            larguraMaxima -\n",
              "            largura\n",
              "        ) / 2;\n",
              "\n",
              "\n",
              "    let posY;\n",
              "\n",
              "\n",
              "    if (alinharEmbaixo) {\n",
              "\n",
              "        posY =\n",
              "\n",
              "            y +\n",
              "            alturaMaxima -\n",
              "            altura;\n",
              "\n",
              "    }\n",
              "\n",
              "    else {\n",
              "\n",
              "        posY =\n",
              "\n",
              "            y +\n",
              "            (\n",
              "                alturaMaxima -\n",
              "                altura\n",
              "            ) / 2;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    ctx.drawImage(\n",
              "\n",
              "        imagem,\n",
              "\n",
              "        posX,\n",
              "\n",
              "        posY,\n",
              "\n",
              "        largura,\n",
              "\n",
              "        altura\n",
              "\n",
              "    );\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// ESCOLHER SPRITE\n",
              "// ============================================================\n",
              "\n",
              "function escolherSpriteLuis() {\n",
              "\n",
              "    if (luis.pulando) {\n",
              "\n",
              "        return pulos[\n",
              "            luis.framePulo\n",
              "        ];\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    if (luis.agachado) {\n",
              "\n",
              "        return agachamentos[0];\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    return corrida[\n",
              "        luis.frameCorrida\n",
              "    ];\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// DESENHAR LUIS\n",
              "// ============================================================\n",
              "\n",
              "function desenharLuis() {\n",
              "\n",
              "    const imagem =\n",
              "        escolherSpriteLuis();\n",
              "\n",
              "\n",
              "    if (\n",
              "\n",
              "        !imagem ||\n",
              "\n",
              "        !imagem.complete ||\n",
              "\n",
              "        imagem.naturalWidth <= 0\n",
              "\n",
              "    ) {\n",
              "\n",
              "        return;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    let larguraMaxima;\n",
              "\n",
              "    let alturaMaxima;\n",
              "\n",
              "\n",
              "    if (luis.agachado) {\n",
              "\n",
              "        larguraMaxima =\n",
              "            LUIS_AGACHADO_LARGURA;\n",
              "\n",
              "        alturaMaxima =\n",
              "            LUIS_AGACHADO_ALTURA;\n",
              "\n",
              "    }\n",
              "\n",
              "    else {\n",
              "\n",
              "        larguraMaxima =\n",
              "            LUIS_LARGURA;\n",
              "\n",
              "        alturaMaxima =\n",
              "            LUIS_ALTURA;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    desenharImagemProporcional(\n",
              "\n",
              "        imagem,\n",
              "\n",
              "        luis.x,\n",
              "\n",
              "        luis.y,\n",
              "\n",
              "        larguraMaxima,\n",
              "\n",
              "        alturaMaxima,\n",
              "\n",
              "        true\n",
              "\n",
              "    );\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// DESENHAR GIZ DO CHÃO\n",
              "// ============================================================\n",
              "\n",
              "function desenharGizChao(\n",
              "    obstaculo\n",
              ") {\n",
              "\n",
              "    desenharImagemProporcional(\n",
              "\n",
              "        imagemGizChao,\n",
              "\n",
              "        obstaculo.x,\n",
              "\n",
              "        obstaculo.y,\n",
              "\n",
              "        obstaculo.largura,\n",
              "\n",
              "        obstaculo.altura,\n",
              "\n",
              "        true\n",
              "\n",
              "    );\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// DESENHAR GIZ VOADOR\n",
              "// ============================================================\n",
              "\n",
              "function desenharGizVoador(\n",
              "    obstaculo\n",
              ") {\n",
              "\n",
              "    if (\n",
              "\n",
              "        !imagemGizVoador.complete ||\n",
              "\n",
              "        imagemGizVoador.naturalWidth <= 0\n",
              "\n",
              "    ) {\n",
              "\n",
              "        return;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    ctx.save();\n",
              "\n",
              "\n",
              "    const centroX =\n",
              "\n",
              "        obstaculo.x +\n",
              "        obstaculo.largura / 2;\n",
              "\n",
              "\n",
              "    const centroY =\n",
              "\n",
              "        obstaculo.y +\n",
              "        obstaculo.altura / 2;\n",
              "\n",
              "\n",
              "    ctx.translate(\n",
              "\n",
              "        centroX,\n",
              "        centroY\n",
              "\n",
              "    );\n",
              "\n",
              "\n",
              "    ctx.rotate(\n",
              "        obstaculo.angulo\n",
              "    );\n",
              "\n",
              "\n",
              "    desenharImagemProporcional(\n",
              "\n",
              "        imagemGizVoador,\n",
              "\n",
              "        -obstaculo.largura / 2,\n",
              "\n",
              "        -obstaculo.altura / 2,\n",
              "\n",
              "        obstaculo.largura,\n",
              "\n",
              "        obstaculo.altura,\n",
              "\n",
              "        false\n",
              "\n",
              "    );\n",
              "\n",
              "\n",
              "    ctx.restore();\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// DESENHAR OBSTÁCULOS\n",
              "// ============================================================\n",
              "\n",
              "function desenharObstaculos() {\n",
              "\n",
              "    for (\n",
              "        const obstaculo of obstaculos\n",
              "    ) {\n",
              "\n",
              "        if (\n",
              "            obstaculo.tipo ===\n",
              "            \"chao\"\n",
              "        ) {\n",
              "\n",
              "            desenharGizChao(\n",
              "                obstaculo\n",
              "            );\n",
              "\n",
              "        }\n",
              "\n",
              "        else if (\n",
              "            obstaculo.tipo ===\n",
              "            \"voador\"\n",
              "        ) {\n",
              "\n",
              "            desenharGizVoador(\n",
              "                obstaculo\n",
              "            );\n",
              "\n",
              "        }\n",
              "\n",
              "    }\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// HITBOX DO LUIS\n",
              "// ============================================================\n",
              "//\n",
              "// A hitbox é menor que o desenho.\n",
              "//\n",
              "// Assim, o jogo só considera que Luiz encostou no giz\n",
              "// quando realmente existe sobreposição física.\n",
              "//\n",
              "// ============================================================\n",
              "\n",
              "function obterHitboxLuis() {\n",
              "\n",
              "    if (\n",
              "\n",
              "        luis.agachado &&\n",
              "\n",
              "        !luis.pulando\n",
              "\n",
              "    ) {\n",
              "\n",
              "        return {\n",
              "\n",
              "            x:\n",
              "                luis.x + 35,\n",
              "\n",
              "            y:\n",
              "                luis.y + 35,\n",
              "\n",
              "            largura:\n",
              "                luis.largura - 70,\n",
              "\n",
              "            altura:\n",
              "                luis.altura - 40\n",
              "\n",
              "        };\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    return {\n",
              "\n",
              "        x:\n",
              "            luis.x + 32,\n",
              "\n",
              "        y:\n",
              "            luis.y + 20,\n",
              "\n",
              "        largura:\n",
              "            luis.largura - 64,\n",
              "\n",
              "        altura:\n",
              "            luis.altura - 25\n",
              "\n",
              "    };\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// COLISÃO\n",
              "// ============================================================\n",
              "\n",
              "function retangulosColidem(a, b) {\n",
              "\n",
              "    return (\n",
              "\n",
              "        a.x <\n",
              "        b.x +\n",
              "        b.largura\n",
              "\n",
              "        &&\n",
              "\n",
              "        a.x +\n",
              "        a.largura >\n",
              "        b.x\n",
              "\n",
              "        &&\n",
              "\n",
              "        a.y <\n",
              "        b.y +\n",
              "        b.altura\n",
              "\n",
              "        &&\n",
              "\n",
              "        a.y +\n",
              "        a.altura >\n",
              "        b.y\n",
              "\n",
              "    );\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// VERIFICAR COLISÕES\n",
              "// ============================================================\n",
              "\n",
              "function verificarColisoes() {\n",
              "\n",
              "    const jogador =\n",
              "        obterHitboxLuis();\n",
              "\n",
              "\n",
              "    for (\n",
              "        const obstaculo of obstaculos\n",
              "    ) {\n",
              "\n",
              "        let caixaObstaculo;\n",
              "\n",
              "\n",
              "        // ====================================================\n",
              "        // GIZ DO CHÃO\n",
              "        // ====================================================\n",
              "\n",
              "        if (\n",
              "            obstaculo.tipo ===\n",
              "            \"chao\"\n",
              "        ) {\n",
              "\n",
              "            caixaObstaculo = {\n",
              "\n",
              "                x:\n",
              "                    obstaculo.x + 18,\n",
              "\n",
              "                y:\n",
              "                    obstaculo.y + 12,\n",
              "\n",
              "                largura:\n",
              "                    obstaculo.largura - 36,\n",
              "\n",
              "                altura:\n",
              "                    obstaculo.altura - 18\n",
              "\n",
              "            };\n",
              "\n",
              "        }\n",
              "\n",
              "\n",
              "        // ====================================================\n",
              "        // GIZ VOADOR\n",
              "        // ====================================================\n",
              "\n",
              "        else {\n",
              "\n",
              "            caixaObstaculo = {\n",
              "\n",
              "                x:\n",
              "                    obstaculo.x + 12,\n",
              "\n",
              "                y:\n",
              "                    obstaculo.y + 8,\n",
              "\n",
              "                largura:\n",
              "                    obstaculo.largura - 24,\n",
              "\n",
              "                altura:\n",
              "                    obstaculo.altura - 16\n",
              "\n",
              "            };\n",
              "\n",
              "        }\n",
              "\n",
              "\n",
              "        // ====================================================\n",
              "        // COLISÃO REAL\n",
              "        // ====================================================\n",
              "\n",
              "        if (\n",
              "            retangulosColidem(\n",
              "                jogador,\n",
              "                caixaObstaculo\n",
              "            )\n",
              "        ) {\n",
              "\n",
              "            jogoRodando =\n",
              "                false;\n",
              "\n",
              "            jogoPerdido =\n",
              "                true;\n",
              "\n",
              "\n",
              "            document\n",
              "                .getElementById(\n",
              "                    \"mensagem\"\n",
              "                )\n",
              "                .textContent =\n",
              "                \"💥 Você encostou no giz!\";\n",
              "\n",
              "\n",
              "            break;\n",
              "\n",
              "        }\n",
              "\n",
              "    }\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// PLACAR\n",
              "// ============================================================\n",
              "\n",
              "function desenharPlacar() {\n",
              "\n",
              "    ctx.fillStyle =\n",
              "        \"rgba(0,0,0,0.70)\";\n",
              "\n",
              "\n",
              "    ctx.fillRect(\n",
              "\n",
              "        15,\n",
              "        15,\n",
              "        220,\n",
              "        55\n",
              "\n",
              "    );\n",
              "\n",
              "\n",
              "    ctx.fillStyle =\n",
              "        \"white\";\n",
              "\n",
              "\n",
              "    ctx.font =\n",
              "        \"bold 26px Arial\";\n",
              "\n",
              "\n",
              "    ctx.textAlign =\n",
              "        \"left\";\n",
              "\n",
              "\n",
              "    ctx.fillText(\n",
              "\n",
              "        \"Pontos: \" +\n",
              "        pontuacao,\n",
              "\n",
              "        30,\n",
              "        50\n",
              "\n",
              "    );\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// GAME OVER\n",
              "// ============================================================\n",
              "\n",
              "function desenharGameOver() {\n",
              "\n",
              "    if (!jogoPerdido) {\n",
              "\n",
              "        return;\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    ctx.fillStyle =\n",
              "        \"rgba(0,0,0,0.65)\";\n",
              "\n",
              "\n",
              "    ctx.fillRect(\n",
              "\n",
              "        0,\n",
              "        0,\n",
              "        LARGURA,\n",
              "        ALTURA\n",
              "\n",
              "    );\n",
              "\n",
              "\n",
              "    ctx.fillStyle =\n",
              "        \"white\";\n",
              "\n",
              "\n",
              "    ctx.textAlign =\n",
              "        \"center\";\n",
              "\n",
              "\n",
              "    ctx.font =\n",
              "        \"bold 50px Arial\";\n",
              "\n",
              "\n",
              "    ctx.fillText(\n",
              "\n",
              "        \"VOCÊ PERDEU!\",\n",
              "\n",
              "        LARGURA / 2,\n",
              "\n",
              "        ALTURA / 2 - 40\n",
              "\n",
              "    );\n",
              "\n",
              "\n",
              "    ctx.font =\n",
              "        \"28px Arial\";\n",
              "\n",
              "\n",
              "    ctx.fillText(\n",
              "\n",
              "        \"Pontuação: \" +\n",
              "        pontuacao,\n",
              "\n",
              "        LARGURA / 2,\n",
              "\n",
              "        ALTURA / 2 + 15\n",
              "\n",
              "    );\n",
              "\n",
              "\n",
              "    ctx.fillText(\n",
              "\n",
              "        \"Clique em REINICIAR\",\n",
              "\n",
              "        LARGURA / 2,\n",
              "\n",
              "        ALTURA / 2 + 65\n",
              "\n",
              "    );\n",
              "\n",
              "\n",
              "    ctx.textAlign =\n",
              "        \"left\";\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// DESENHAR\n",
              "// ============================================================\n",
              "\n",
              "function desenhar() {\n",
              "\n",
              "    ctx.clearRect(\n",
              "\n",
              "        0,\n",
              "        0,\n",
              "        LARGURA,\n",
              "        ALTURA\n",
              "\n",
              "    );\n",
              "\n",
              "\n",
              "    desenharCenario();\n",
              "\n",
              "    desenharObstaculos();\n",
              "\n",
              "    desenharLuis();\n",
              "\n",
              "    desenharPlacar();\n",
              "\n",
              "    desenharGameOver();\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// REINICIAR\n",
              "// ============================================================\n",
              "\n",
              "function reiniciar() {\n",
              "\n",
              "    luis.x = 130;\n",
              "\n",
              "\n",
              "    luis.y =\n",
              "        CHAO -\n",
              "        LUIS_ALTURA;\n",
              "\n",
              "\n",
              "    luis.largura =\n",
              "        LUIS_LARGURA;\n",
              "\n",
              "\n",
              "    luis.altura =\n",
              "        LUIS_ALTURA;\n",
              "\n",
              "\n",
              "    luis.velocidadeY = 0;\n",
              "\n",
              "\n",
              "    luis.pulando = false;\n",
              "\n",
              "\n",
              "    luis.agachado = false;\n",
              "\n",
              "\n",
              "    luis.frameCorrida = 0;\n",
              "\n",
              "\n",
              "    luis.framePulo = 0;\n",
              "\n",
              "\n",
              "    luis.frameAgachado = 0;\n",
              "\n",
              "\n",
              "    luis.contadorAnimacao = 0;\n",
              "\n",
              "\n",
              "    luis.alturaPulo = 0;\n",
              "\n",
              "\n",
              "    // ========================================================\n",
              "    // OBSTÁCULOS\n",
              "    // ========================================================\n",
              "\n",
              "    obstaculos = [];\n",
              "\n",
              "\n",
              "    contadorObstaculo = 0;\n",
              "\n",
              "\n",
              "    intervaloObstaculo = 100;\n",
              "\n",
              "\n",
              "    ultimoSpawnChaoX = -9999;\n",
              "\n",
              "\n",
              "    // ========================================================\n",
              "    // PONTUAÇÃO\n",
              "    // ========================================================\n",
              "\n",
              "    pontuacao = 0;\n",
              "\n",
              "    acumuladorPontuacao = 0;\n",
              "\n",
              "\n",
              "    // ========================================================\n",
              "    // VELOCIDADE\n",
              "    // ========================================================\n",
              "\n",
              "    velocidade =\n",
              "        VELOCIDADE_INICIAL;\n",
              "\n",
              "\n",
              "    nivelVelocidade = 0;\n",
              "\n",
              "\n",
              "    // ========================================================\n",
              "    // CENÁRIO\n",
              "    // ========================================================\n",
              "\n",
              "    deslocamentoCenario = 0;\n",
              "\n",
              "\n",
              "    // ========================================================\n",
              "    // ESTADO\n",
              "    // ========================================================\n",
              "\n",
              "    jogoRodando = true;\n",
              "\n",
              "    jogoPerdido = false;\n",
              "\n",
              "    pressionandoBaixo = false;\n",
              "\n",
              "\n",
              "    document\n",
              "        .getElementById(\n",
              "            \"mensagem\"\n",
              "        )\n",
              "        .textContent =\n",
              "        \"🏃 Luis está correndo!\";\n",
              "\n",
              "\n",
              "    desenhar();\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// TECLADO\n",
              "// ============================================================\n",
              "\n",
              "document.addEventListener(\n",
              "\n",
              "    \"keydown\",\n",
              "\n",
              "    function(event) {\n",
              "\n",
              "        if (\n",
              "\n",
              "            event.code ===\n",
              "            \"ArrowUp\" ||\n",
              "\n",
              "            event.code ===\n",
              "            \"Space\"\n",
              "\n",
              "        ) {\n",
              "\n",
              "            event.preventDefault();\n",
              "\n",
              "            pular();\n",
              "\n",
              "        }\n",
              "\n",
              "\n",
              "        if (\n",
              "\n",
              "            event.code ===\n",
              "            \"ArrowDown\"\n",
              "\n",
              "        ) {\n",
              "\n",
              "            event.preventDefault();\n",
              "\n",
              "            agachar(true);\n",
              "\n",
              "        }\n",
              "\n",
              "    }\n",
              "\n",
              ");\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// SOLTAR TECLA\n",
              "// ============================================================\n",
              "\n",
              "document.addEventListener(\n",
              "\n",
              "    \"keyup\",\n",
              "\n",
              "    function(event) {\n",
              "\n",
              "        if (\n",
              "\n",
              "            event.code ===\n",
              "            \"ArrowDown\"\n",
              "\n",
              "        ) {\n",
              "\n",
              "            event.preventDefault();\n",
              "\n",
              "            agachar(false);\n",
              "\n",
              "        }\n",
              "\n",
              "    }\n",
              "\n",
              ");\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// BOTÃO PULAR\n",
              "// ============================================================\n",
              "\n",
              "document\n",
              "    .getElementById(\"pular\")\n",
              "    .addEventListener(\n",
              "        \"click\",\n",
              "        pular\n",
              "    );\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// BOTÃO AGACHAR\n",
              "// ============================================================\n",
              "\n",
              "const botaoAgachar =\n",
              "\n",
              "    document.getElementById(\n",
              "        \"agachar\"\n",
              "    );\n",
              "\n",
              "\n",
              "botaoAgachar.addEventListener(\n",
              "\n",
              "    \"mousedown\",\n",
              "\n",
              "    function() {\n",
              "\n",
              "        agachar(true);\n",
              "\n",
              "    }\n",
              "\n",
              ");\n",
              "\n",
              "\n",
              "botaoAgachar.addEventListener(\n",
              "\n",
              "    \"mouseup\",\n",
              "\n",
              "    function() {\n",
              "\n",
              "        agachar(false);\n",
              "\n",
              "    }\n",
              "\n",
              ");\n",
              "\n",
              "\n",
              "botaoAgachar.addEventListener(\n",
              "\n",
              "    \"mouseleave\",\n",
              "\n",
              "    function() {\n",
              "\n",
              "        agachar(false);\n",
              "\n",
              "    }\n",
              "\n",
              ");\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// TOUCH AGACHAR\n",
              "// ============================================================\n",
              "\n",
              "botaoAgachar.addEventListener(\n",
              "\n",
              "    \"touchstart\",\n",
              "\n",
              "    function(event) {\n",
              "\n",
              "        event.preventDefault();\n",
              "\n",
              "        agachar(true);\n",
              "\n",
              "    }\n",
              "\n",
              ");\n",
              "\n",
              "\n",
              "botaoAgachar.addEventListener(\n",
              "\n",
              "    \"touchend\",\n",
              "\n",
              "    function(event) {\n",
              "\n",
              "        event.preventDefault();\n",
              "\n",
              "        agachar(false);\n",
              "\n",
              "    }\n",
              "\n",
              ");\n",
              "\n",
              "\n",
              "botaoAgachar.addEventListener(\n",
              "\n",
              "    \"touchcancel\",\n",
              "\n",
              "    function(event) {\n",
              "\n",
              "        event.preventDefault();\n",
              "\n",
              "        agachar(false);\n",
              "\n",
              "    }\n",
              "\n",
              ");\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// REINICIAR\n",
              "// ============================================================\n",
              "\n",
              "document\n",
              "    .getElementById(\"reiniciar\")\n",
              "    .addEventListener(\n",
              "        \"click\",\n",
              "        reiniciar\n",
              "    );\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// LOOP PRINCIPAL\n",
              "// ============================================================\n",
              "\n",
              "function loop() {\n",
              "\n",
              "    if (jogoRodando) {\n",
              "\n",
              "        atualizarLuis();\n",
              "\n",
              "        atualizarObstaculos();\n",
              "\n",
              "        atualizarPontuacao();\n",
              "\n",
              "        atualizarVelocidade();\n",
              "\n",
              "        atualizarCenario();\n",
              "\n",
              "        verificarColisoes();\n",
              "\n",
              "    }\n",
              "\n",
              "\n",
              "    desenhar();\n",
              "\n",
              "\n",
              "    requestAnimationFrame(\n",
              "        loop\n",
              "    );\n",
              "\n",
              "}\n",
              "\n",
              "\n",
              "// ============================================================\n",
              "// INICIAR\n",
              "// ============================================================\n",
              "\n",
              "loop();\n",
              "\n",
              "\n",
              "</script>\n",
              "\n",
              "</body>\n",
              "\n",
              "</html>\n",
              "\n"
            ],
            "text/plain": [
              "<IPython.core.display.HTML object>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "import os\n",
        "import base64\n",
        "import json\n",
        "from IPython.display import HTML, display\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# CONFIGURAÇÕES\n",
        "# ============================================================\n",
        "\n",
        "PASTA = \"/content\"\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# CARREGAR IMAGENS\n",
        "# ============================================================\n",
        "\n",
        "def carregar_base64(nome):\n",
        "\n",
        "    caminho = os.path.join(\n",
        "        PASTA,\n",
        "        os.path.basename(nome)\n",
        "    )\n",
        "\n",
        "    if not os.path.exists(caminho):\n",
        "\n",
        "        print(\n",
        "            \"⚠️ Imagem não encontrada:\",\n",
        "            caminho\n",
        "        )\n",
        "\n",
        "        return \"\"\n",
        "\n",
        "    with open(caminho, \"rb\") as arquivo:\n",
        "\n",
        "        dados = base64.b64encode(\n",
        "            arquivo.read()\n",
        "        ).decode()\n",
        "\n",
        "    return \"data:image/png;base64,\" + dados\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# CENÁRIO\n",
        "# ============================================================\n",
        "\n",
        "fundo = carregar_base64(\n",
        "    \"/content/cenario.png\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# GIZES\n",
        "# ============================================================\n",
        "\n",
        "giz_chao = carregar_base64(\n",
        "    \"/content/giz chao.png\"\n",
        ")\n",
        "\n",
        "giz_voador = carregar_base64(\n",
        "    \"/content/giz voador.png\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# SPRITES DE CORRIDA\n",
        "# ============================================================\n",
        "\n",
        "correndo = [\n",
        "\n",
        "    carregar_base64(\"/content/correndo1.png\"),\n",
        "    carregar_base64(\"/content/correndo2.png\"),\n",
        "    carregar_base64(\"/content/correndo3.png\"),\n",
        "    carregar_base64(\"/content/correndo4.png\")\n",
        "\n",
        "]\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# SPRITES DE PULO\n",
        "# ============================================================\n",
        "\n",
        "pulo = [\n",
        "\n",
        "    carregar_base64(\"/content/pulo1.png\"),\n",
        "    carregar_base64(\"/content/pulo2.png\"),\n",
        "    carregar_base64(\"/content/pulo3.png\")\n",
        "\n",
        "]\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# AGACHADO\n",
        "# ============================================================\n",
        "\n",
        "agachado = [\n",
        "\n",
        "    carregar_base64(\n",
        "        \"/content/agachado2.png\"\n",
        "    )\n",
        "\n",
        "]\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# PARADO\n",
        "# ============================================================\n",
        "\n",
        "parado = carregar_base64(\n",
        "    \"/content/nochao.png\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# DADOS PARA JAVASCRIPT\n",
        "# ============================================================\n",
        "\n",
        "dados = {\n",
        "\n",
        "    \"fundo\": fundo,\n",
        "\n",
        "    \"giz_chao\": giz_chao,\n",
        "\n",
        "    \"giz_voador\": giz_voador,\n",
        "\n",
        "    \"correndo1\": correndo[0],\n",
        "    \"correndo2\": correndo[1],\n",
        "    \"correndo3\": correndo[2],\n",
        "    \"correndo4\": correndo[3],\n",
        "\n",
        "    \"pulo1\": pulo[0],\n",
        "    \"pulo2\": pulo[1],\n",
        "    \"pulo3\": pulo[2],\n",
        "\n",
        "    \"agachado2\": agachado[0],\n",
        "\n",
        "    \"parado\": parado\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "dados_js = json.dumps(dados)\n",
        "\n",
        "\n",
        "print(\"✅ Imagens carregadas!\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# HTML\n",
        "# ============================================================\n",
        "\n",
        "html = r\"\"\"\n",
        "\n",
        "<!DOCTYPE html>\n",
        "\n",
        "<html lang=\"pt-BR\">\n",
        "\n",
        "<head>\n",
        "\n",
        "<meta charset=\"UTF-8\">\n",
        "\n",
        "<meta name=\"viewport\"\n",
        "content=\"width=device-width, initial-scale=1.0\">\n",
        "\n",
        "<title>Corrida do Luis</title>\n",
        "\n",
        "<style>\n",
        "\n",
        "body {\n",
        "\n",
        "    margin: 0;\n",
        "    padding: 0;\n",
        "\n",
        "    background: #202020;\n",
        "\n",
        "    font-family: Arial, sans-serif;\n",
        "\n",
        "    text-align: center;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "#container {\n",
        "\n",
        "    width: 1000px;\n",
        "\n",
        "    max-width: 95vw;\n",
        "\n",
        "    margin: 15px auto;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "canvas {\n",
        "\n",
        "    width: 100%;\n",
        "\n",
        "    height: auto;\n",
        "\n",
        "    display: block;\n",
        "\n",
        "    border: 3px solid white;\n",
        "\n",
        "    border-radius: 8px;\n",
        "\n",
        "    image-rendering: pixelated;\n",
        "\n",
        "    box-sizing: border-box;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "#controles {\n",
        "\n",
        "    margin-top: 12px;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "button {\n",
        "\n",
        "    font-size: 18px;\n",
        "\n",
        "    padding: 12px 20px;\n",
        "\n",
        "    margin: 5px;\n",
        "\n",
        "    border: none;\n",
        "\n",
        "    border-radius: 10px;\n",
        "\n",
        "    cursor: pointer;\n",
        "\n",
        "    touch-action: none;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "button:active {\n",
        "\n",
        "    transform: scale(0.95);\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "#mensagem {\n",
        "\n",
        "    color: white;\n",
        "\n",
        "    font-size: 18px;\n",
        "\n",
        "    margin-top: 8px;\n",
        "\n",
        "}\n",
        "\n",
        "</style>\n",
        "\n",
        "</head>\n",
        "\n",
        "\n",
        "<body>\n",
        "\n",
        "\n",
        "<div id=\"container\">\n",
        "\n",
        "\n",
        "<canvas\n",
        "    id=\"canvas\"\n",
        "    width=\"1000\"\n",
        "    height=\"666\">\n",
        "</canvas>\n",
        "\n",
        "\n",
        "<div id=\"controles\">\n",
        "\n",
        "<button id=\"pular\">\n",
        "⬆️ PULAR\n",
        "</button>\n",
        "\n",
        "<button id=\"agachar\">\n",
        "⬇️ AGACHAR\n",
        "</button>\n",
        "\n",
        "<button id=\"reiniciar\">\n",
        "🔄 REINICIAR\n",
        "</button>\n",
        "\n",
        "</div>\n",
        "\n",
        "\n",
        "<div id=\"mensagem\">\n",
        "🏃 Luis está correndo!\n",
        "</div>\n",
        "\n",
        "\n",
        "</div>\n",
        "\n",
        "\n",
        "<script>\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// IMAGENS\n",
        "// ============================================================\n",
        "\n",
        "const imagens = __DADOS__;\n",
        "\n",
        "\n",
        "function criarImagem(src) {\n",
        "\n",
        "    const img = new Image();\n",
        "\n",
        "    img.src = src || \"\";\n",
        "\n",
        "    return img;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// CENÁRIO\n",
        "// ============================================================\n",
        "\n",
        "const imagemFundo =\n",
        "    criarImagem(\n",
        "        imagens.fundo\n",
        "    );\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// GIZES\n",
        "// ============================================================\n",
        "\n",
        "const imagemGizChao =\n",
        "    criarImagem(\n",
        "        imagens.giz_chao\n",
        "    );\n",
        "\n",
        "\n",
        "const imagemGizVoador =\n",
        "    criarImagem(\n",
        "        imagens.giz_voador\n",
        "    );\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// CORRIDA\n",
        "// ============================================================\n",
        "\n",
        "const corrida = [\n",
        "\n",
        "    criarImagem(imagens.correndo1),\n",
        "    criarImagem(imagens.correndo2),\n",
        "    criarImagem(imagens.correndo3),\n",
        "    criarImagem(imagens.correndo4)\n",
        "\n",
        "];\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// PULO\n",
        "// ============================================================\n",
        "\n",
        "const pulos = [\n",
        "\n",
        "    criarImagem(imagens.pulo1),\n",
        "    criarImagem(imagens.pulo2),\n",
        "    criarImagem(imagens.pulo3)\n",
        "\n",
        "];\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// AGACHAMENTO\n",
        "// ============================================================\n",
        "\n",
        "const agachamentos = [\n",
        "\n",
        "    criarImagem(\n",
        "        imagens.agachado2\n",
        "    )\n",
        "\n",
        "];\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// PARADO\n",
        "// ============================================================\n",
        "\n",
        "const spriteParado =\n",
        "    criarImagem(\n",
        "        imagens.parado\n",
        "    );\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// CANVAS\n",
        "// ============================================================\n",
        "\n",
        "const canvas =\n",
        "    document.getElementById(\n",
        "        \"canvas\"\n",
        "    );\n",
        "\n",
        "\n",
        "const ctx =\n",
        "    canvas.getContext(\n",
        "        \"2d\"\n",
        "    );\n",
        "\n",
        "\n",
        "ctx.imageSmoothingEnabled =\n",
        "    false;\n",
        "\n",
        "\n",
        "const LARGURA =\n",
        "    canvas.width;\n",
        "\n",
        "\n",
        "const ALTURA =\n",
        "    canvas.height;\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// CHÃO\n",
        "// ============================================================\n",
        "\n",
        "const CHAO = 461;\n",
        "\n",
        "const CHAO_AGACHADO = 490;\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// TAMANHO NORMAL\n",
        "// ============================================================\n",
        "\n",
        "const LUIS_LARGURA = 105;\n",
        "\n",
        "const LUIS_ALTURA = 105;\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// TAMANHO AGACHADO\n",
        "// ============================================================\n",
        "\n",
        "const LUIS_AGACHADO_LARGURA = 130;\n",
        "\n",
        "const LUIS_AGACHADO_ALTURA = 136;\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// FÍSICA\n",
        "// ============================================================\n",
        "\n",
        "const GRAVIDADE = 0.75;\n",
        "\n",
        "const FORCA_PULO = -17;\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// CENÁRIO\n",
        "// ============================================================\n",
        "\n",
        "let deslocamentoCenario = 0;\n",
        "\n",
        "let larguraCenario = 0;\n",
        "\n",
        "let panoramaPronto = false;\n",
        "\n",
        "const POSICAO_VERTICAL_CENARIO = 0;\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// PERSONAGEM\n",
        "// ============================================================\n",
        "\n",
        "let luis = {\n",
        "\n",
        "    x: 130,\n",
        "\n",
        "    y:\n",
        "        CHAO -\n",
        "        LUIS_ALTURA,\n",
        "\n",
        "    largura:\n",
        "        LUIS_LARGURA,\n",
        "\n",
        "    altura:\n",
        "        LUIS_ALTURA,\n",
        "\n",
        "    velocidadeY: 0,\n",
        "\n",
        "    pulando: false,\n",
        "\n",
        "    agachado: false,\n",
        "\n",
        "    frameCorrida: 0,\n",
        "\n",
        "    framePulo: 0,\n",
        "\n",
        "    frameAgachado: 0,\n",
        "\n",
        "    contadorAnimacao: 0,\n",
        "\n",
        "    alturaPulo: 0\n",
        "\n",
        "};\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// ESTADO\n",
        "// ============================================================\n",
        "\n",
        "let jogoRodando = true;\n",
        "\n",
        "let jogoPerdido = false;\n",
        "\n",
        "let pontuacao = 0;\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// PONTUAÇÃO\n",
        "// ============================================================\n",
        "//\n",
        "// A pontuação sobe continuamente enquanto o personagem\n",
        "// corre.\n",
        "//\n",
        "// O sistema usa o tempo do jogo, parecido com o conceito\n",
        "// de pontuação contínua do Dino Runner.\n",
        "//\n",
        "// ============================================================\n",
        "\n",
        "let acumuladorPontuacao = 0;\n",
        "\n",
        "\n",
        "// Quantos pontos por segundo aproximadamente.\n",
        "//\n",
        "// 100 pontos = 10 segundos no ritmo inicial.\n",
        "//\n",
        "// Conforme o jogo fica mais rápido, a pontuação acompanha\n",
        "// a velocidade.\n",
        "//\n",
        "// ============================================================\n",
        "\n",
        "const PONTOS_POR_SEGUNDO = 10;\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// VELOCIDADE\n",
        "// ============================================================\n",
        "//\n",
        "// A velocidade inicial foi aumentada.\n",
        "//\n",
        "// A cada 100 pontos ocorre um aumento.\n",
        "//\n",
        "// ============================================================\n",
        "\n",
        "const VELOCIDADE_INICIAL = 7.0;\n",
        "\n",
        "\n",
        "// Aumento de velocidade a cada 100 pontos.\n",
        "\n",
        "const AUMENTO_A_CADA_100 = 0.75;\n",
        "\n",
        "\n",
        "// Limite máximo.\n",
        "\n",
        "const VELOCIDADE_MAXIMA = 20;\n",
        "\n",
        "\n",
        "let velocidade =\n",
        "    VELOCIDADE_INICIAL;\n",
        "\n",
        "\n",
        "let nivelVelocidade = 0;\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// VELOCIDADE DO GIZ VOADOR\n",
        "// ============================================================\n",
        "\n",
        "const MULTIPLICADOR_GIZ_VOADOR = 1.8;\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// DISTÂNCIA DOS GIZES DO CHÃO\n",
        "// ============================================================\n",
        "//\n",
        "// Distância maior para facilitar o pulo.\n",
        "//\n",
        "// O intervalo entre eles também é aleatório.\n",
        "//\n",
        "// ============================================================\n",
        "\n",
        "const DISTANCIA_MINIMA_GIZ_CHAO = 380;\n",
        "\n",
        "const DISTANCIA_MAXIMA_GIZ_CHAO = 650;\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// DISTÂNCIA MÍNIMA ENTRE OBSTÁCULOS\n",
        "// ============================================================\n",
        "\n",
        "const DISTANCIA_MINIMA_OBSTACULOS = 300;\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// CONTROLE\n",
        "// ============================================================\n",
        "\n",
        "let pressionandoBaixo = false;\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// PREPARAR CENÁRIO\n",
        "// ============================================================\n",
        "\n",
        "function prepararPanorama() {\n",
        "\n",
        "    if (\n",
        "\n",
        "        !imagemFundo.complete ||\n",
        "\n",
        "        imagemFundo.naturalWidth <= 0 ||\n",
        "\n",
        "        imagemFundo.naturalHeight <= 0\n",
        "\n",
        "    ) {\n",
        "\n",
        "        return;\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    if (panoramaPronto) {\n",
        "\n",
        "        return;\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    const escala =\n",
        "\n",
        "        ALTURA /\n",
        "        imagemFundo.naturalHeight;\n",
        "\n",
        "\n",
        "    larguraCenario =\n",
        "\n",
        "        imagemFundo.naturalWidth *\n",
        "        escala;\n",
        "\n",
        "\n",
        "    panoramaPronto = true;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// PULAR\n",
        "// ============================================================\n",
        "\n",
        "function pular() {\n",
        "\n",
        "    if (\n",
        "\n",
        "        !jogoRodando ||\n",
        "\n",
        "        luis.pulando ||\n",
        "\n",
        "        luis.agachado\n",
        "\n",
        "    ) {\n",
        "\n",
        "        return;\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    luis.pulando = true;\n",
        "\n",
        "    luis.velocidadeY =\n",
        "        FORCA_PULO;\n",
        "\n",
        "    luis.framePulo = 0;\n",
        "\n",
        "    luis.contadorAnimacao = 0;\n",
        "\n",
        "    luis.alturaPulo = 0;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// AGACHAR\n",
        "// ============================================================\n",
        "\n",
        "function agachar(estado) {\n",
        "\n",
        "    pressionandoBaixo =\n",
        "        estado;\n",
        "\n",
        "\n",
        "    if (!jogoRodando) {\n",
        "\n",
        "        return;\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    if (!luis.pulando) {\n",
        "\n",
        "        luis.agachado =\n",
        "            estado;\n",
        "\n",
        "\n",
        "        if (estado) {\n",
        "\n",
        "            luis.largura =\n",
        "                LUIS_AGACHADO_LARGURA;\n",
        "\n",
        "            luis.altura =\n",
        "                LUIS_AGACHADO_ALTURA;\n",
        "\n",
        "            luis.y =\n",
        "                CHAO_AGACHADO -\n",
        "                luis.altura;\n",
        "\n",
        "        }\n",
        "\n",
        "        else {\n",
        "\n",
        "            luis.largura =\n",
        "                LUIS_LARGURA;\n",
        "\n",
        "            luis.altura =\n",
        "                LUIS_ALTURA;\n",
        "\n",
        "            luis.y =\n",
        "                CHAO -\n",
        "                luis.altura;\n",
        "\n",
        "        }\n",
        "\n",
        "    }\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// ANIMAÇÃO\n",
        "// ============================================================\n",
        "\n",
        "function atualizarAnimacao() {\n",
        "\n",
        "    luis.contadorAnimacao++;\n",
        "\n",
        "\n",
        "    if (luis.pulando) {\n",
        "\n",
        "        if (\n",
        "            luis.contadorAnimacao >= 7\n",
        "        ) {\n",
        "\n",
        "            luis.framePulo++;\n",
        "\n",
        "\n",
        "            if (\n",
        "                luis.framePulo >=\n",
        "                pulos.length\n",
        "            ) {\n",
        "\n",
        "                luis.framePulo =\n",
        "                    pulos.length - 1;\n",
        "\n",
        "            }\n",
        "\n",
        "\n",
        "            luis.contadorAnimacao = 0;\n",
        "\n",
        "        }\n",
        "\n",
        "\n",
        "        return;\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    if (luis.agachado) {\n",
        "\n",
        "        luis.frameAgachado = 0;\n",
        "\n",
        "        return;\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    if (\n",
        "        luis.contadorAnimacao >= 6\n",
        "    ) {\n",
        "\n",
        "        luis.frameCorrida++;\n",
        "\n",
        "        luis.frameCorrida %=\n",
        "\n",
        "            corrida.length;\n",
        "\n",
        "        luis.contadorAnimacao = 0;\n",
        "\n",
        "    }\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// ATUALIZAR LUIS\n",
        "// ============================================================\n",
        "\n",
        "function atualizarLuis() {\n",
        "\n",
        "    atualizarAnimacao();\n",
        "\n",
        "\n",
        "    // --------------------------------------------------------\n",
        "    // PULO\n",
        "    // --------------------------------------------------------\n",
        "\n",
        "    if (luis.pulando) {\n",
        "\n",
        "        luis.velocidadeY +=\n",
        "            GRAVIDADE;\n",
        "\n",
        "\n",
        "        luis.alturaPulo -=\n",
        "            luis.velocidadeY;\n",
        "\n",
        "\n",
        "        if (\n",
        "\n",
        "            luis.alturaPulo <= 0 &&\n",
        "\n",
        "            luis.velocidadeY > 0\n",
        "\n",
        "        ) {\n",
        "\n",
        "            luis.alturaPulo = 0;\n",
        "\n",
        "            luis.velocidadeY = 0;\n",
        "\n",
        "            luis.pulando = false;\n",
        "\n",
        "            luis.framePulo = 0;\n",
        "\n",
        "            luis.contadorAnimacao = 0;\n",
        "\n",
        "\n",
        "            luis.largura =\n",
        "                LUIS_LARGURA;\n",
        "\n",
        "            luis.altura =\n",
        "                LUIS_ALTURA;\n",
        "\n",
        "\n",
        "            if (pressionandoBaixo) {\n",
        "\n",
        "                luis.agachado = true;\n",
        "\n",
        "                luis.largura =\n",
        "                    LUIS_AGACHADO_LARGURA;\n",
        "\n",
        "                luis.altura =\n",
        "                    LUIS_AGACHADO_ALTURA;\n",
        "\n",
        "                luis.y =\n",
        "                    CHAO_AGACHADO -\n",
        "                    luis.altura;\n",
        "\n",
        "            }\n",
        "\n",
        "        }\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    // --------------------------------------------------------\n",
        "    // POSIÇÃO VERTICAL\n",
        "    // --------------------------------------------------------\n",
        "\n",
        "    if (!luis.pulando) {\n",
        "\n",
        "        if (luis.agachado) {\n",
        "\n",
        "            luis.y =\n",
        "                CHAO_AGACHADO -\n",
        "                luis.altura;\n",
        "\n",
        "        }\n",
        "\n",
        "        else {\n",
        "\n",
        "            luis.y =\n",
        "                CHAO -\n",
        "                luis.altura;\n",
        "\n",
        "        }\n",
        "\n",
        "    }\n",
        "\n",
        "    else {\n",
        "\n",
        "        luis.y =\n",
        "\n",
        "            CHAO -\n",
        "\n",
        "            luis.altura -\n",
        "\n",
        "            luis.alturaPulo;\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    // --------------------------------------------------------\n",
        "    // AGACHAMENTO\n",
        "    // --------------------------------------------------------\n",
        "\n",
        "    if (!luis.pulando) {\n",
        "\n",
        "        if (pressionandoBaixo) {\n",
        "\n",
        "            luis.agachado = true;\n",
        "\n",
        "            luis.largura =\n",
        "                LUIS_AGACHADO_LARGURA;\n",
        "\n",
        "            luis.altura =\n",
        "                LUIS_AGACHADO_ALTURA;\n",
        "\n",
        "            luis.y =\n",
        "                CHAO_AGACHADO -\n",
        "                luis.altura;\n",
        "\n",
        "        }\n",
        "\n",
        "        else {\n",
        "\n",
        "            luis.agachado = false;\n",
        "\n",
        "            luis.largura =\n",
        "                LUIS_LARGURA;\n",
        "\n",
        "            luis.altura =\n",
        "                LUIS_ALTURA;\n",
        "\n",
        "            luis.y =\n",
        "                CHAO -\n",
        "                luis.altura;\n",
        "\n",
        "        }\n",
        "\n",
        "    }\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// OBSTÁCULOS\n",
        "// ============================================================\n",
        "\n",
        "let obstaculos = [];\n",
        "\n",
        "let contadorObstaculo = 0;\n",
        "\n",
        "let intervaloObstaculo = 100;\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// ÚLTIMA POSIÇÃO DO GIZ DO CHÃO\n",
        "// ============================================================\n",
        "\n",
        "let ultimoSpawnChaoX = -9999;\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// GIZ DO CHÃO\n",
        "// ============================================================\n",
        "\n",
        "function criarObstaculoChao(\n",
        "    xExtra = 0\n",
        ") {\n",
        "\n",
        "    const largura = 85;\n",
        "\n",
        "    const altura = 70;\n",
        "\n",
        "\n",
        "    // ========================================================\n",
        "    // DISTÂNCIA ALEATÓRIA\n",
        "    // ========================================================\n",
        "\n",
        "    const distanciaAleatoria =\n",
        "\n",
        "        DISTANCIA_MINIMA_GIZ_CHAO +\n",
        "\n",
        "        Math.random() *\n",
        "\n",
        "        (\n",
        "            DISTANCIA_MAXIMA_GIZ_CHAO -\n",
        "            DISTANCIA_MINIMA_GIZ_CHAO\n",
        "        );\n",
        "\n",
        "\n",
        "    let posicaoX =\n",
        "\n",
        "        LARGURA +\n",
        "        80 +\n",
        "        xExtra;\n",
        "\n",
        "\n",
        "    // ========================================================\n",
        "    // GARANTIR DISTÂNCIA\n",
        "    // ========================================================\n",
        "\n",
        "    if (\n",
        "\n",
        "        ultimoSpawnChaoX > -9000 &&\n",
        "\n",
        "        posicaoX <\n",
        "            ultimoSpawnChaoX +\n",
        "            distanciaAleatoria\n",
        "\n",
        "    ) {\n",
        "\n",
        "        posicaoX =\n",
        "\n",
        "            ultimoSpawnChaoX +\n",
        "            distanciaAleatoria;\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    obstaculos.push({\n",
        "\n",
        "        tipo: \"chao\",\n",
        "\n",
        "        x:\n",
        "            posicaoX,\n",
        "\n",
        "        y:\n",
        "            CHAO -\n",
        "            altura,\n",
        "\n",
        "        largura:\n",
        "            largura,\n",
        "\n",
        "        altura:\n",
        "            altura,\n",
        "\n",
        "        velocidade:\n",
        "            velocidade\n",
        "\n",
        "    });\n",
        "\n",
        "\n",
        "    ultimoSpawnChaoX =\n",
        "        posicaoX;\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// GIZ VOADOR\n",
        "// ============================================================\n",
        "\n",
        "function criarObstaculoVoador(\n",
        "    xExtra = 0\n",
        ") {\n",
        "\n",
        "    const largura = 70;\n",
        "\n",
        "    const altura = 48;\n",
        "\n",
        "\n",
        "    // ========================================================\n",
        "    // ALTURA DO GIZ VOADOR\n",
        "    // ========================================================\n",
        "\n",
        "    const yBase =\n",
        "        CHAO - 115;\n",
        "\n",
        "\n",
        "    const posicaoX =\n",
        "\n",
        "        LARGURA +\n",
        "        80 +\n",
        "        xExtra;\n",
        "\n",
        "\n",
        "    obstaculos.push({\n",
        "\n",
        "        tipo: \"voador\",\n",
        "\n",
        "        x:\n",
        "            posicaoX,\n",
        "\n",
        "        y:\n",
        "            yBase,\n",
        "\n",
        "        yBase:\n",
        "            yBase,\n",
        "\n",
        "        largura:\n",
        "            largura,\n",
        "\n",
        "        altura:\n",
        "            altura,\n",
        "\n",
        "        velocidade:\n",
        "\n",
        "            velocidade *\n",
        "            MULTIPLICADOR_GIZ_VOADOR,\n",
        "\n",
        "        angulo:\n",
        "\n",
        "            Math.random() *\n",
        "            Math.PI *\n",
        "            2,\n",
        "\n",
        "        velocidadeRotacao:\n",
        "\n",
        "            0.08 +\n",
        "            Math.random() * 0.04\n",
        "\n",
        "    });\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// CRIAR GRUPO DE OBSTÁCULOS\n",
        "// ============================================================\n",
        "\n",
        "function criarGrupoObstaculos() {\n",
        "\n",
        "    const sorteio =\n",
        "        Math.random();\n",
        "\n",
        "\n",
        "    // ========================================================\n",
        "    // INÍCIO DO JOGO\n",
        "    // ========================================================\n",
        "\n",
        "    if (pontuacao < 100) {\n",
        "\n",
        "        if (sorteio < 0.58) {\n",
        "\n",
        "            criarObstaculoChao();\n",
        "\n",
        "        }\n",
        "\n",
        "        else if (sorteio < 0.84) {\n",
        "\n",
        "            criarObstaculoVoador();\n",
        "\n",
        "        }\n",
        "\n",
        "        else {\n",
        "\n",
        "            criarObstaculoChao();\n",
        "\n",
        "\n",
        "            const distancia =\n",
        "\n",
        "                DISTANCIA_MINIMA_GIZ_CHAO +\n",
        "\n",
        "                Math.random() *\n",
        "                180;\n",
        "\n",
        "\n",
        "            criarObstaculoChao(\n",
        "                distancia\n",
        "            );\n",
        "\n",
        "        }\n",
        "\n",
        "        return;\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    // ========================================================\n",
        "    // JOGO MAIS RÁPIDO\n",
        "    // ========================================================\n",
        "\n",
        "    if (pontuacao < 300) {\n",
        "\n",
        "        if (sorteio < 0.45) {\n",
        "\n",
        "            criarObstaculoChao();\n",
        "\n",
        "        }\n",
        "\n",
        "        else if (sorteio < 0.70) {\n",
        "\n",
        "            criarObstaculoVoador();\n",
        "\n",
        "        }\n",
        "\n",
        "        else if (sorteio < 0.88) {\n",
        "\n",
        "            criarObstaculoChao();\n",
        "\n",
        "\n",
        "            const distancia =\n",
        "\n",
        "                DISTANCIA_MINIMA_GIZ_CHAO +\n",
        "\n",
        "                Math.random() *\n",
        "                200;\n",
        "\n",
        "\n",
        "            criarObstaculoChao(\n",
        "                distancia\n",
        "            );\n",
        "\n",
        "        }\n",
        "\n",
        "        else {\n",
        "\n",
        "            criarObstaculoChao();\n",
        "\n",
        "\n",
        "            const distancia =\n",
        "\n",
        "                DISTANCIA_MINIMA_OBSTACULOS +\n",
        "\n",
        "                Math.random() *\n",
        "                180;\n",
        "\n",
        "\n",
        "            criarObstaculoVoador(\n",
        "                distancia\n",
        "            );\n",
        "\n",
        "        }\n",
        "\n",
        "        return;\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    // ========================================================\n",
        "    // JOGO AVANÇADO\n",
        "    // ========================================================\n",
        "\n",
        "    if (sorteio < 0.38) {\n",
        "\n",
        "        criarObstaculoChao();\n",
        "\n",
        "    }\n",
        "\n",
        "    else if (sorteio < 0.64) {\n",
        "\n",
        "        criarObstaculoVoador();\n",
        "\n",
        "    }\n",
        "\n",
        "    else if (sorteio < 0.82) {\n",
        "\n",
        "        criarObstaculoChao();\n",
        "\n",
        "\n",
        "        const distancia =\n",
        "\n",
        "            DISTANCIA_MINIMA_GIZ_CHAO +\n",
        "\n",
        "            Math.random() *\n",
        "            220;\n",
        "\n",
        "\n",
        "        criarObstaculoChao(\n",
        "            distancia\n",
        "        );\n",
        "\n",
        "    }\n",
        "\n",
        "    else {\n",
        "\n",
        "        criarObstaculoChao();\n",
        "\n",
        "\n",
        "        const distancia =\n",
        "\n",
        "            DISTANCIA_MINIMA_OBSTACULOS +\n",
        "\n",
        "            Math.random() *\n",
        "            220;\n",
        "\n",
        "\n",
        "        criarObstaculoVoador(\n",
        "            distancia\n",
        "        );\n",
        "\n",
        "    }\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// ATUALIZAR OBSTÁCULOS\n",
        "// ============================================================\n",
        "\n",
        "function atualizarObstaculos() {\n",
        "\n",
        "    contadorObstaculo++;\n",
        "\n",
        "\n",
        "    // ========================================================\n",
        "    // DIFICULDADE DO SPAWN\n",
        "    // ========================================================\n",
        "\n",
        "    const nivelDificuldade =\n",
        "\n",
        "        Math.floor(\n",
        "            pontuacao / 100\n",
        "        );\n",
        "\n",
        "\n",
        "    let reducao =\n",
        "\n",
        "        Math.min(\n",
        "            nivelDificuldade * 3,\n",
        "            15\n",
        "        );\n",
        "\n",
        "\n",
        "    let intervaloMinimo =\n",
        "\n",
        "        90 -\n",
        "        reducao;\n",
        "\n",
        "\n",
        "    let intervaloMaximo =\n",
        "\n",
        "        135 -\n",
        "        reducao;\n",
        "\n",
        "\n",
        "    if (\n",
        "        intervaloMinimo < 70\n",
        "    ) {\n",
        "\n",
        "        intervaloMinimo = 70;\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    if (\n",
        "        intervaloMaximo < 90\n",
        "    ) {\n",
        "\n",
        "        intervaloMaximo = 90;\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    // ========================================================\n",
        "    // SPAWN\n",
        "    // ========================================================\n",
        "\n",
        "    if (\n",
        "        contadorObstaculo >=\n",
        "        intervaloObstaculo\n",
        "    ) {\n",
        "\n",
        "        criarGrupoObstaculos();\n",
        "\n",
        "        contadorObstaculo = 0;\n",
        "\n",
        "\n",
        "        intervaloObstaculo =\n",
        "\n",
        "            intervaloMinimo +\n",
        "\n",
        "            Math.random() *\n",
        "\n",
        "            (\n",
        "                intervaloMaximo -\n",
        "                intervaloMinimo\n",
        "            );\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    // ========================================================\n",
        "    // MOVER GIZES\n",
        "    // ========================================================\n",
        "\n",
        "    for (\n",
        "\n",
        "        let i =\n",
        "            obstaculos.length - 1;\n",
        "\n",
        "        i >= 0;\n",
        "\n",
        "        i--\n",
        "\n",
        "    ) {\n",
        "\n",
        "        const obstaculo =\n",
        "            obstaculos[i];\n",
        "\n",
        "\n",
        "        // ====================================================\n",
        "        // GIZ VOADOR\n",
        "        // ====================================================\n",
        "\n",
        "        if (\n",
        "            obstaculo.tipo ===\n",
        "            \"voador\"\n",
        "        ) {\n",
        "\n",
        "            obstaculo.velocidade =\n",
        "\n",
        "                velocidade *\n",
        "                MULTIPLICADOR_GIZ_VOADOR;\n",
        "\n",
        "\n",
        "            obstaculo.x -=\n",
        "                obstaculo.velocidade;\n",
        "\n",
        "\n",
        "            obstaculo.y =\n",
        "                obstaculo.yBase;\n",
        "\n",
        "\n",
        "            obstaculo.angulo +=\n",
        "                obstaculo.velocidadeRotacao;\n",
        "\n",
        "        }\n",
        "\n",
        "        else {\n",
        "\n",
        "            // =================================================\n",
        "            // GIZ DO CHÃO\n",
        "            // =================================================\n",
        "\n",
        "            obstaculo.velocidade =\n",
        "                velocidade;\n",
        "\n",
        "\n",
        "            obstaculo.x -=\n",
        "                obstaculo.velocidade;\n",
        "\n",
        "        }\n",
        "\n",
        "\n",
        "        // ====================================================\n",
        "        // REMOVER GIZ QUE SAIU DA TELA\n",
        "        // ====================================================\n",
        "\n",
        "        if (\n",
        "\n",
        "            obstaculo.x +\n",
        "            obstaculo.largura < 0\n",
        "\n",
        "        ) {\n",
        "\n",
        "            obstaculos.splice(\n",
        "                i,\n",
        "                1\n",
        "            );\n",
        "\n",
        "        }\n",
        "\n",
        "    }\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// ATUALIZAR PONTUAÇÃO\n",
        "// ============================================================\n",
        "//\n",
        "// A pontuação agora é baseada no tempo.\n",
        "//\n",
        "// Ela não depende dos gizes.\n",
        "//\n",
        "// Portanto o jogador ganha pontos simplesmente por continuar\n",
        "// correndo.\n",
        "//\n",
        "// ============================================================\n",
        "\n",
        "function atualizarPontuacao() {\n",
        "\n",
        "    // Aproximação de 60 FPS.\n",
        "    //\n",
        "    // Isso deixa a pontuação estável mesmo se o computador\n",
        "    // tiver pequenas variações no FPS.\n",
        "\n",
        "    acumuladorPontuacao +=\n",
        "        PONTOS_POR_SEGUNDO / 60;\n",
        "\n",
        "\n",
        "    if (\n",
        "        acumuladorPontuacao >= 1\n",
        "    ) {\n",
        "\n",
        "        const pontosInteiros =\n",
        "\n",
        "            Math.floor(\n",
        "                acumuladorPontuacao\n",
        "            );\n",
        "\n",
        "\n",
        "        pontuacao +=\n",
        "            pontosInteiros;\n",
        "\n",
        "\n",
        "        acumuladorPontuacao -=\n",
        "            pontosInteiros;\n",
        "\n",
        "    }\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// ATUALIZAR VELOCIDADE\n",
        "// ============================================================\n",
        "//\n",
        "// A cada 100 pontos aumenta a velocidade.\n",
        "//\n",
        "// Exemplo:\n",
        "//\n",
        "// 0 pontos    = 7.00\n",
        "// 100 pontos  = 7.75\n",
        "// 200 pontos  = 8.50\n",
        "// 300 pontos  = 9.25\n",
        "// 400 pontos  = 10.00\n",
        "//\n",
        "// E continua aumentando até a velocidade máxima.\n",
        "//\n",
        "// ============================================================\n",
        "\n",
        "function atualizarVelocidade() {\n",
        "\n",
        "    const novoNivel =\n",
        "\n",
        "        Math.floor(\n",
        "            pontuacao / 100\n",
        "        );\n",
        "\n",
        "\n",
        "    if (\n",
        "        novoNivel !==\n",
        "        nivelVelocidade\n",
        "    ) {\n",
        "\n",
        "        nivelVelocidade =\n",
        "            novoNivel;\n",
        "\n",
        "\n",
        "        velocidade =\n",
        "\n",
        "            VELOCIDADE_INICIAL +\n",
        "\n",
        "            (\n",
        "                nivelVelocidade *\n",
        "                AUMENTO_A_CADA_100\n",
        "            );\n",
        "\n",
        "\n",
        "        if (\n",
        "            velocidade >\n",
        "            VELOCIDADE_MAXIMA\n",
        "        ) {\n",
        "\n",
        "            velocidade =\n",
        "                VELOCIDADE_MAXIMA;\n",
        "\n",
        "        }\n",
        "\n",
        "    }\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// ATUALIZAR CENÁRIO\n",
        "// ============================================================\n",
        "\n",
        "function atualizarCenario() {\n",
        "\n",
        "    prepararPanorama();\n",
        "\n",
        "\n",
        "    if (\n",
        "\n",
        "        !panoramaPronto ||\n",
        "\n",
        "        larguraCenario <= 0\n",
        "\n",
        "    ) {\n",
        "\n",
        "        return;\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    deslocamentoCenario +=\n",
        "        velocidade;\n",
        "\n",
        "\n",
        "    while (\n",
        "\n",
        "        deslocamentoCenario >=\n",
        "        larguraCenario\n",
        "\n",
        "    ) {\n",
        "\n",
        "        deslocamentoCenario -=\n",
        "            larguraCenario;\n",
        "\n",
        "    }\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// DESENHAR CENÁRIO\n",
        "// ============================================================\n",
        "\n",
        "function desenharCenario() {\n",
        "\n",
        "    ctx.fillStyle =\n",
        "        \"#168bd0\";\n",
        "\n",
        "\n",
        "    ctx.fillRect(\n",
        "\n",
        "        0,\n",
        "        0,\n",
        "        LARGURA,\n",
        "        ALTURA\n",
        "\n",
        "    );\n",
        "\n",
        "\n",
        "    prepararPanorama();\n",
        "\n",
        "\n",
        "    if (\n",
        "\n",
        "        !panoramaPronto ||\n",
        "\n",
        "        larguraCenario <= 0\n",
        "\n",
        "    ) {\n",
        "\n",
        "        return;\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    const x =\n",
        "        -deslocamentoCenario;\n",
        "\n",
        "\n",
        "    ctx.drawImage(\n",
        "\n",
        "        imagemFundo,\n",
        "\n",
        "        x,\n",
        "\n",
        "        POSICAO_VERTICAL_CENARIO,\n",
        "\n",
        "        larguraCenario,\n",
        "\n",
        "        ALTURA\n",
        "\n",
        "    );\n",
        "\n",
        "\n",
        "    ctx.drawImage(\n",
        "\n",
        "        imagemFundo,\n",
        "\n",
        "        x +\n",
        "        larguraCenario,\n",
        "\n",
        "        POSICAO_VERTICAL_CENARIO,\n",
        "\n",
        "        larguraCenario,\n",
        "\n",
        "        ALTURA\n",
        "\n",
        "    );\n",
        "\n",
        "\n",
        "    ctx.drawImage(\n",
        "\n",
        "        imagemFundo,\n",
        "\n",
        "        x +\n",
        "        larguraCenario * 2,\n",
        "\n",
        "        POSICAO_VERTICAL_CENARIO,\n",
        "\n",
        "        larguraCenario,\n",
        "\n",
        "        ALTURA\n",
        "\n",
        "    );\n",
        "\n",
        "\n",
        "    ctx.drawImage(\n",
        "\n",
        "        imagemFundo,\n",
        "\n",
        "        x +\n",
        "        larguraCenario * 3,\n",
        "\n",
        "        POSICAO_VERTICAL_CENARIO,\n",
        "\n",
        "        larguraCenario,\n",
        "\n",
        "        ALTURA\n",
        "\n",
        "    );\n",
        "\n",
        "\n",
        "    ctx.drawImage(\n",
        "\n",
        "        imagemFundo,\n",
        "\n",
        "        x -\n",
        "        larguraCenario,\n",
        "\n",
        "        POSICAO_VERTICAL_CENARIO,\n",
        "\n",
        "        larguraCenario,\n",
        "\n",
        "        ALTURA\n",
        "\n",
        "    );\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// DESENHAR IMAGEM PROPORCIONAL\n",
        "// ============================================================\n",
        "\n",
        "function desenharImagemProporcional(\n",
        "\n",
        "    imagem,\n",
        "\n",
        "    x,\n",
        "\n",
        "    y,\n",
        "\n",
        "    larguraMaxima,\n",
        "\n",
        "    alturaMaxima,\n",
        "\n",
        "    alinharEmbaixo = false\n",
        "\n",
        ") {\n",
        "\n",
        "    if (\n",
        "\n",
        "        !imagem ||\n",
        "\n",
        "        !imagem.complete ||\n",
        "\n",
        "        imagem.naturalWidth <= 0 ||\n",
        "\n",
        "        imagem.naturalHeight <= 0\n",
        "\n",
        "    ) {\n",
        "\n",
        "        return;\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    const proporcao =\n",
        "\n",
        "        imagem.naturalWidth /\n",
        "        imagem.naturalHeight;\n",
        "\n",
        "\n",
        "    let largura =\n",
        "        larguraMaxima;\n",
        "\n",
        "\n",
        "    let altura =\n",
        "        largura /\n",
        "        proporcao;\n",
        "\n",
        "\n",
        "    if (\n",
        "        altura >\n",
        "        alturaMaxima\n",
        "    ) {\n",
        "\n",
        "        altura =\n",
        "            alturaMaxima;\n",
        "\n",
        "\n",
        "        largura =\n",
        "            altura *\n",
        "            proporcao;\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    if (\n",
        "        largura >\n",
        "        larguraMaxima\n",
        "    ) {\n",
        "\n",
        "        largura =\n",
        "            larguraMaxima;\n",
        "\n",
        "\n",
        "        altura =\n",
        "            largura /\n",
        "            proporcao;\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    const posX =\n",
        "\n",
        "        x +\n",
        "        (\n",
        "            larguraMaxima -\n",
        "            largura\n",
        "        ) / 2;\n",
        "\n",
        "\n",
        "    let posY;\n",
        "\n",
        "\n",
        "    if (alinharEmbaixo) {\n",
        "\n",
        "        posY =\n",
        "\n",
        "            y +\n",
        "            alturaMaxima -\n",
        "            altura;\n",
        "\n",
        "    }\n",
        "\n",
        "    else {\n",
        "\n",
        "        posY =\n",
        "\n",
        "            y +\n",
        "            (\n",
        "                alturaMaxima -\n",
        "                altura\n",
        "            ) / 2;\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    ctx.drawImage(\n",
        "\n",
        "        imagem,\n",
        "\n",
        "        posX,\n",
        "\n",
        "        posY,\n",
        "\n",
        "        largura,\n",
        "\n",
        "        altura\n",
        "\n",
        "    );\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// ESCOLHER SPRITE\n",
        "// ============================================================\n",
        "\n",
        "function escolherSpriteLuis() {\n",
        "\n",
        "    if (luis.pulando) {\n",
        "\n",
        "        return pulos[\n",
        "            luis.framePulo\n",
        "        ];\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    if (luis.agachado) {\n",
        "\n",
        "        return agachamentos[0];\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    return corrida[\n",
        "        luis.frameCorrida\n",
        "    ];\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// DESENHAR LUIS\n",
        "// ============================================================\n",
        "\n",
        "function desenharLuis() {\n",
        "\n",
        "    const imagem =\n",
        "        escolherSpriteLuis();\n",
        "\n",
        "\n",
        "    if (\n",
        "\n",
        "        !imagem ||\n",
        "\n",
        "        !imagem.complete ||\n",
        "\n",
        "        imagem.naturalWidth <= 0\n",
        "\n",
        "    ) {\n",
        "\n",
        "        return;\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    let larguraMaxima;\n",
        "\n",
        "    let alturaMaxima;\n",
        "\n",
        "\n",
        "    if (luis.agachado) {\n",
        "\n",
        "        larguraMaxima =\n",
        "            LUIS_AGACHADO_LARGURA;\n",
        "\n",
        "        alturaMaxima =\n",
        "            LUIS_AGACHADO_ALTURA;\n",
        "\n",
        "    }\n",
        "\n",
        "    else {\n",
        "\n",
        "        larguraMaxima =\n",
        "            LUIS_LARGURA;\n",
        "\n",
        "        alturaMaxima =\n",
        "            LUIS_ALTURA;\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    desenharImagemProporcional(\n",
        "\n",
        "        imagem,\n",
        "\n",
        "        luis.x,\n",
        "\n",
        "        luis.y,\n",
        "\n",
        "        larguraMaxima,\n",
        "\n",
        "        alturaMaxima,\n",
        "\n",
        "        true\n",
        "\n",
        "    );\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// DESENHAR GIZ DO CHÃO\n",
        "// ============================================================\n",
        "\n",
        "function desenharGizChao(\n",
        "    obstaculo\n",
        ") {\n",
        "\n",
        "    desenharImagemProporcional(\n",
        "\n",
        "        imagemGizChao,\n",
        "\n",
        "        obstaculo.x,\n",
        "\n",
        "        obstaculo.y,\n",
        "\n",
        "        obstaculo.largura,\n",
        "\n",
        "        obstaculo.altura,\n",
        "\n",
        "        true\n",
        "\n",
        "    );\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// DESENHAR GIZ VOADOR\n",
        "// ============================================================\n",
        "\n",
        "function desenharGizVoador(\n",
        "    obstaculo\n",
        ") {\n",
        "\n",
        "    if (\n",
        "\n",
        "        !imagemGizVoador.complete ||\n",
        "\n",
        "        imagemGizVoador.naturalWidth <= 0\n",
        "\n",
        "    ) {\n",
        "\n",
        "        return;\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    ctx.save();\n",
        "\n",
        "\n",
        "    const centroX =\n",
        "\n",
        "        obstaculo.x +\n",
        "        obstaculo.largura / 2;\n",
        "\n",
        "\n",
        "    const centroY =\n",
        "\n",
        "        obstaculo.y +\n",
        "        obstaculo.altura / 2;\n",
        "\n",
        "\n",
        "    ctx.translate(\n",
        "\n",
        "        centroX,\n",
        "        centroY\n",
        "\n",
        "    );\n",
        "\n",
        "\n",
        "    ctx.rotate(\n",
        "        obstaculo.angulo\n",
        "    );\n",
        "\n",
        "\n",
        "    desenharImagemProporcional(\n",
        "\n",
        "        imagemGizVoador,\n",
        "\n",
        "        -obstaculo.largura / 2,\n",
        "\n",
        "        -obstaculo.altura / 2,\n",
        "\n",
        "        obstaculo.largura,\n",
        "\n",
        "        obstaculo.altura,\n",
        "\n",
        "        false\n",
        "\n",
        "    );\n",
        "\n",
        "\n",
        "    ctx.restore();\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// DESENHAR OBSTÁCULOS\n",
        "// ============================================================\n",
        "\n",
        "function desenharObstaculos() {\n",
        "\n",
        "    for (\n",
        "        const obstaculo of obstaculos\n",
        "    ) {\n",
        "\n",
        "        if (\n",
        "            obstaculo.tipo ===\n",
        "            \"chao\"\n",
        "        ) {\n",
        "\n",
        "            desenharGizChao(\n",
        "                obstaculo\n",
        "            );\n",
        "\n",
        "        }\n",
        "\n",
        "        else if (\n",
        "            obstaculo.tipo ===\n",
        "            \"voador\"\n",
        "        ) {\n",
        "\n",
        "            desenharGizVoador(\n",
        "                obstaculo\n",
        "            );\n",
        "\n",
        "        }\n",
        "\n",
        "    }\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// HITBOX DO LUIS\n",
        "// ============================================================\n",
        "//\n",
        "// A hitbox é menor que o desenho.\n",
        "//\n",
        "// Assim, o jogo só considera que Luiz encostou no giz\n",
        "// quando realmente existe sobreposição física.\n",
        "//\n",
        "// ============================================================\n",
        "\n",
        "function obterHitboxLuis() {\n",
        "\n",
        "    if (\n",
        "\n",
        "        luis.agachado &&\n",
        "\n",
        "        !luis.pulando\n",
        "\n",
        "    ) {\n",
        "\n",
        "        return {\n",
        "\n",
        "            x:\n",
        "                luis.x + 35,\n",
        "\n",
        "            y:\n",
        "                luis.y + 35,\n",
        "\n",
        "            largura:\n",
        "                luis.largura - 70,\n",
        "\n",
        "            altura:\n",
        "                luis.altura - 40\n",
        "\n",
        "        };\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    return {\n",
        "\n",
        "        x:\n",
        "            luis.x + 32,\n",
        "\n",
        "        y:\n",
        "            luis.y + 20,\n",
        "\n",
        "        largura:\n",
        "            luis.largura - 64,\n",
        "\n",
        "        altura:\n",
        "            luis.altura - 25\n",
        "\n",
        "    };\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// COLISÃO\n",
        "// ============================================================\n",
        "\n",
        "function retangulosColidem(a, b) {\n",
        "\n",
        "    return (\n",
        "\n",
        "        a.x <\n",
        "        b.x +\n",
        "        b.largura\n",
        "\n",
        "        &&\n",
        "\n",
        "        a.x +\n",
        "        a.largura >\n",
        "        b.x\n",
        "\n",
        "        &&\n",
        "\n",
        "        a.y <\n",
        "        b.y +\n",
        "        b.altura\n",
        "\n",
        "        &&\n",
        "\n",
        "        a.y +\n",
        "        a.altura >\n",
        "        b.y\n",
        "\n",
        "    );\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// VERIFICAR COLISÕES\n",
        "// ============================================================\n",
        "\n",
        "function verificarColisoes() {\n",
        "\n",
        "    const jogador =\n",
        "        obterHitboxLuis();\n",
        "\n",
        "\n",
        "    for (\n",
        "        const obstaculo of obstaculos\n",
        "    ) {\n",
        "\n",
        "        let caixaObstaculo;\n",
        "\n",
        "\n",
        "        // ====================================================\n",
        "        // GIZ DO CHÃO\n",
        "        // ====================================================\n",
        "\n",
        "        if (\n",
        "            obstaculo.tipo ===\n",
        "            \"chao\"\n",
        "        ) {\n",
        "\n",
        "            caixaObstaculo = {\n",
        "\n",
        "                x:\n",
        "                    obstaculo.x + 18,\n",
        "\n",
        "                y:\n",
        "                    obstaculo.y + 12,\n",
        "\n",
        "                largura:\n",
        "                    obstaculo.largura - 36,\n",
        "\n",
        "                altura:\n",
        "                    obstaculo.altura - 18\n",
        "\n",
        "            };\n",
        "\n",
        "        }\n",
        "\n",
        "\n",
        "        // ====================================================\n",
        "        // GIZ VOADOR\n",
        "        // ====================================================\n",
        "\n",
        "        else {\n",
        "\n",
        "            caixaObstaculo = {\n",
        "\n",
        "                x:\n",
        "                    obstaculo.x + 12,\n",
        "\n",
        "                y:\n",
        "                    obstaculo.y + 8,\n",
        "\n",
        "                largura:\n",
        "                    obstaculo.largura - 24,\n",
        "\n",
        "                altura:\n",
        "                    obstaculo.altura - 16\n",
        "\n",
        "            };\n",
        "\n",
        "        }\n",
        "\n",
        "\n",
        "        // ====================================================\n",
        "        // COLISÃO REAL\n",
        "        // ====================================================\n",
        "\n",
        "        if (\n",
        "            retangulosColidem(\n",
        "                jogador,\n",
        "                caixaObstaculo\n",
        "            )\n",
        "        ) {\n",
        "\n",
        "            jogoRodando =\n",
        "                false;\n",
        "\n",
        "            jogoPerdido =\n",
        "                true;\n",
        "\n",
        "\n",
        "            document\n",
        "                .getElementById(\n",
        "                    \"mensagem\"\n",
        "                )\n",
        "                .textContent =\n",
        "                \"💥 Você encostou no giz!\";\n",
        "\n",
        "\n",
        "            break;\n",
        "\n",
        "        }\n",
        "\n",
        "    }\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// PLACAR\n",
        "// ============================================================\n",
        "\n",
        "function desenharPlacar() {\n",
        "\n",
        "    ctx.fillStyle =\n",
        "        \"rgba(0,0,0,0.70)\";\n",
        "\n",
        "\n",
        "    ctx.fillRect(\n",
        "\n",
        "        15,\n",
        "        15,\n",
        "        220,\n",
        "        55\n",
        "\n",
        "    );\n",
        "\n",
        "\n",
        "    ctx.fillStyle =\n",
        "        \"white\";\n",
        "\n",
        "\n",
        "    ctx.font =\n",
        "        \"bold 26px Arial\";\n",
        "\n",
        "\n",
        "    ctx.textAlign =\n",
        "        \"left\";\n",
        "\n",
        "\n",
        "    ctx.fillText(\n",
        "\n",
        "        \"Pontos: \" +\n",
        "        pontuacao,\n",
        "\n",
        "        30,\n",
        "        50\n",
        "\n",
        "    );\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// GAME OVER\n",
        "// ============================================================\n",
        "\n",
        "function desenharGameOver() {\n",
        "\n",
        "    if (!jogoPerdido) {\n",
        "\n",
        "        return;\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    ctx.fillStyle =\n",
        "        \"rgba(0,0,0,0.65)\";\n",
        "\n",
        "\n",
        "    ctx.fillRect(\n",
        "\n",
        "        0,\n",
        "        0,\n",
        "        LARGURA,\n",
        "        ALTURA\n",
        "\n",
        "    );\n",
        "\n",
        "\n",
        "    ctx.fillStyle =\n",
        "        \"white\";\n",
        "\n",
        "\n",
        "    ctx.textAlign =\n",
        "        \"center\";\n",
        "\n",
        "\n",
        "    ctx.font =\n",
        "        \"bold 50px Arial\";\n",
        "\n",
        "\n",
        "    ctx.fillText(\n",
        "\n",
        "        \"VOCÊ PERDEU!\",\n",
        "\n",
        "        LARGURA / 2,\n",
        "\n",
        "        ALTURA / 2 - 40\n",
        "\n",
        "    );\n",
        "\n",
        "\n",
        "    ctx.font =\n",
        "        \"28px Arial\";\n",
        "\n",
        "\n",
        "    ctx.fillText(\n",
        "\n",
        "        \"Pontuação: \" +\n",
        "        pontuacao,\n",
        "\n",
        "        LARGURA / 2,\n",
        "\n",
        "        ALTURA / 2 + 15\n",
        "\n",
        "    );\n",
        "\n",
        "\n",
        "    ctx.fillText(\n",
        "\n",
        "        \"Clique em REINICIAR\",\n",
        "\n",
        "        LARGURA / 2,\n",
        "\n",
        "        ALTURA / 2 + 65\n",
        "\n",
        "    );\n",
        "\n",
        "\n",
        "    ctx.textAlign =\n",
        "        \"left\";\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// DESENHAR\n",
        "// ============================================================\n",
        "\n",
        "function desenhar() {\n",
        "\n",
        "    ctx.clearRect(\n",
        "\n",
        "        0,\n",
        "        0,\n",
        "        LARGURA,\n",
        "        ALTURA\n",
        "\n",
        "    );\n",
        "\n",
        "\n",
        "    desenharCenario();\n",
        "\n",
        "    desenharObstaculos();\n",
        "\n",
        "    desenharLuis();\n",
        "\n",
        "    desenharPlacar();\n",
        "\n",
        "    desenharGameOver();\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// REINICIAR\n",
        "// ============================================================\n",
        "\n",
        "function reiniciar() {\n",
        "\n",
        "    luis.x = 130;\n",
        "\n",
        "\n",
        "    luis.y =\n",
        "        CHAO -\n",
        "        LUIS_ALTURA;\n",
        "\n",
        "\n",
        "    luis.largura =\n",
        "        LUIS_LARGURA;\n",
        "\n",
        "\n",
        "    luis.altura =\n",
        "        LUIS_ALTURA;\n",
        "\n",
        "\n",
        "    luis.velocidadeY = 0;\n",
        "\n",
        "\n",
        "    luis.pulando = false;\n",
        "\n",
        "\n",
        "    luis.agachado = false;\n",
        "\n",
        "\n",
        "    luis.frameCorrida = 0;\n",
        "\n",
        "\n",
        "    luis.framePulo = 0;\n",
        "\n",
        "\n",
        "    luis.frameAgachado = 0;\n",
        "\n",
        "\n",
        "    luis.contadorAnimacao = 0;\n",
        "\n",
        "\n",
        "    luis.alturaPulo = 0;\n",
        "\n",
        "\n",
        "    // ========================================================\n",
        "    // OBSTÁCULOS\n",
        "    // ========================================================\n",
        "\n",
        "    obstaculos = [];\n",
        "\n",
        "\n",
        "    contadorObstaculo = 0;\n",
        "\n",
        "\n",
        "    intervaloObstaculo = 100;\n",
        "\n",
        "\n",
        "    ultimoSpawnChaoX = -9999;\n",
        "\n",
        "\n",
        "    // ========================================================\n",
        "    // PONTUAÇÃO\n",
        "    // ========================================================\n",
        "\n",
        "    pontuacao = 0;\n",
        "\n",
        "    acumuladorPontuacao = 0;\n",
        "\n",
        "\n",
        "    // ========================================================\n",
        "    // VELOCIDADE\n",
        "    // ========================================================\n",
        "\n",
        "    velocidade =\n",
        "        VELOCIDADE_INICIAL;\n",
        "\n",
        "\n",
        "    nivelVelocidade = 0;\n",
        "\n",
        "\n",
        "    // ========================================================\n",
        "    // CENÁRIO\n",
        "    // ========================================================\n",
        "\n",
        "    deslocamentoCenario = 0;\n",
        "\n",
        "\n",
        "    // ========================================================\n",
        "    // ESTADO\n",
        "    // ========================================================\n",
        "\n",
        "    jogoRodando = true;\n",
        "\n",
        "    jogoPerdido = false;\n",
        "\n",
        "    pressionandoBaixo = false;\n",
        "\n",
        "\n",
        "    document\n",
        "        .getElementById(\n",
        "            \"mensagem\"\n",
        "        )\n",
        "        .textContent =\n",
        "        \"🏃 Luis está correndo!\";\n",
        "\n",
        "\n",
        "    desenhar();\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// TECLADO\n",
        "// ============================================================\n",
        "\n",
        "document.addEventListener(\n",
        "\n",
        "    \"keydown\",\n",
        "\n",
        "    function(event) {\n",
        "\n",
        "        if (\n",
        "\n",
        "            event.code ===\n",
        "            \"ArrowUp\" ||\n",
        "\n",
        "            event.code ===\n",
        "            \"Space\"\n",
        "\n",
        "        ) {\n",
        "\n",
        "            event.preventDefault();\n",
        "\n",
        "            pular();\n",
        "\n",
        "        }\n",
        "\n",
        "\n",
        "        if (\n",
        "\n",
        "            event.code ===\n",
        "            \"ArrowDown\"\n",
        "\n",
        "        ) {\n",
        "\n",
        "            event.preventDefault();\n",
        "\n",
        "            agachar(true);\n",
        "\n",
        "        }\n",
        "\n",
        "    }\n",
        "\n",
        ");\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// SOLTAR TECLA\n",
        "// ============================================================\n",
        "\n",
        "document.addEventListener(\n",
        "\n",
        "    \"keyup\",\n",
        "\n",
        "    function(event) {\n",
        "\n",
        "        if (\n",
        "\n",
        "            event.code ===\n",
        "            \"ArrowDown\"\n",
        "\n",
        "        ) {\n",
        "\n",
        "            event.preventDefault();\n",
        "\n",
        "            agachar(false);\n",
        "\n",
        "        }\n",
        "\n",
        "    }\n",
        "\n",
        ");\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// BOTÃO PULAR\n",
        "// ============================================================\n",
        "\n",
        "document\n",
        "    .getElementById(\"pular\")\n",
        "    .addEventListener(\n",
        "        \"click\",\n",
        "        pular\n",
        "    );\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// BOTÃO AGACHAR\n",
        "// ============================================================\n",
        "\n",
        "const botaoAgachar =\n",
        "\n",
        "    document.getElementById(\n",
        "        \"agachar\"\n",
        "    );\n",
        "\n",
        "\n",
        "botaoAgachar.addEventListener(\n",
        "\n",
        "    \"mousedown\",\n",
        "\n",
        "    function() {\n",
        "\n",
        "        agachar(true);\n",
        "\n",
        "    }\n",
        "\n",
        ");\n",
        "\n",
        "\n",
        "botaoAgachar.addEventListener(\n",
        "\n",
        "    \"mouseup\",\n",
        "\n",
        "    function() {\n",
        "\n",
        "        agachar(false);\n",
        "\n",
        "    }\n",
        "\n",
        ");\n",
        "\n",
        "\n",
        "botaoAgachar.addEventListener(\n",
        "\n",
        "    \"mouseleave\",\n",
        "\n",
        "    function() {\n",
        "\n",
        "        agachar(false);\n",
        "\n",
        "    }\n",
        "\n",
        ");\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// TOUCH AGACHAR\n",
        "// ============================================================\n",
        "\n",
        "botaoAgachar.addEventListener(\n",
        "\n",
        "    \"touchstart\",\n",
        "\n",
        "    function(event) {\n",
        "\n",
        "        event.preventDefault();\n",
        "\n",
        "        agachar(true);\n",
        "\n",
        "    }\n",
        "\n",
        ");\n",
        "\n",
        "\n",
        "botaoAgachar.addEventListener(\n",
        "\n",
        "    \"touchend\",\n",
        "\n",
        "    function(event) {\n",
        "\n",
        "        event.preventDefault();\n",
        "\n",
        "        agachar(false);\n",
        "\n",
        "    }\n",
        "\n",
        ");\n",
        "\n",
        "\n",
        "botaoAgachar.addEventListener(\n",
        "\n",
        "    \"touchcancel\",\n",
        "\n",
        "    function(event) {\n",
        "\n",
        "        event.preventDefault();\n",
        "\n",
        "        agachar(false);\n",
        "\n",
        "    }\n",
        "\n",
        ");\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// REINICIAR\n",
        "// ============================================================\n",
        "\n",
        "document\n",
        "    .getElementById(\"reiniciar\")\n",
        "    .addEventListener(\n",
        "        \"click\",\n",
        "        reiniciar\n",
        "    );\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// LOOP PRINCIPAL\n",
        "// ============================================================\n",
        "\n",
        "function loop() {\n",
        "\n",
        "    if (jogoRodando) {\n",
        "\n",
        "        atualizarLuis();\n",
        "\n",
        "        atualizarObstaculos();\n",
        "\n",
        "        atualizarPontuacao();\n",
        "\n",
        "        atualizarVelocidade();\n",
        "\n",
        "        atualizarCenario();\n",
        "\n",
        "        verificarColisoes();\n",
        "\n",
        "    }\n",
        "\n",
        "\n",
        "    desenhar();\n",
        "\n",
        "\n",
        "    requestAnimationFrame(\n",
        "        loop\n",
        "    );\n",
        "\n",
        "}\n",
        "\n",
        "\n",
        "// ============================================================\n",
        "// INICIAR\n",
        "// ============================================================\n",
        "\n",
        "loop();\n",
        "\n",
        "\n",
        "</script>\n",
        "\n",
        "</body>\n",
        "\n",
        "</html>\n",
        "\n",
        "\"\"\"\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# INSERIR IMAGENS\n",
        "# ============================================================\n",
        "\n",
        "html = html.replace(\n",
        "\n",
        "    \"__DADOS__\",\n",
        "\n",
        "    dados_js\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# MOSTRAR JOGO\n",
        "# ============================================================\n",
        "\n",
        "display(\n",
        "    HTML(html)\n",
        ")"
      ]
    }
  ],
